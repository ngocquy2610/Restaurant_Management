<% order = dining_order %>
<% payment = order.completed_payment(dining_order.payments) %>
<div class="rounded-2xl bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="font-serif text-lg font-semibold text-gray-900">
        Order #<%= order.id %> · Table <%= order.table&.table_number || "—" %>
      </p>
      <p class="mt-1 text-sm text-gray-500">
        <%= order.updated_at&.strftime("%d %b %Y · %I:%M %p") %>
        · <%= order.order_items.size %> <%= "item".pluralize(order.order_items.size) %>
      </p>
    </div>
    <div class="text-right">
      <p class="mt-1 font-semibold text-[#8A1C2B]">
        <% if payment.present? %>
          <%= number_to_currency(payment.total_amount_vnd, unit: "₫", precision: 0) %>
        <% else %>
          <%= number_to_currency(order.subtotal.to_d, unit: "$", precision: 2) %>
        <% end %>
      </p>
      <p class="mt-1 text-xs text-gray-500">
        <% if payment.present? %>
          <%= payment.payment_method&.name || "Payment" %> · <%= payment.status.humanize %>
        <% else %>
          <%= order.status.humanize %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <% if policy(order).show? %>
      <%= link_to "View order", order_path(order),
            class: "rounded-full border border-gray-200 px-4 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50" %>
    <% end %>
    <% if payment.present? %>
      <%= link_to "View invoice", bill_order_payment_path(order, payment),
            class: "rounded-full border border-gray-200 px-4 py-1.5 text-xs font-semibold text-gray-700 hover:border-[#8A1C2B] hover:text-[#8A1C2B]" %>
      <%= link_to "PDF", bill_order_payment_path(order, payment, format: :pdf),
            class: "rounded-full bg-[#8A1C2B]/10 px-4 py-1.5 text-xs font-semibold text-[#8A1C2B] hover:bg-[#8A1C2B]/20" %>
    <% else %>
      <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">No completed payment</span>
    <% end %>
  </div>
</div>
