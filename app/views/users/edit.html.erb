<% content_for :title, "Editing user" %>

<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/70">User management</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Edit user</h1>
        <p class="mt-3 text-sm text-gray-600">Update this user's profile details. Password changes are handled separately.</p>
      </div>

      <%= link_to "← Back to user", user_path(@user),
          class: "inline-flex shrink-0 items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
    </div>

    <%= render "users/form" %>
  </div>
</div>