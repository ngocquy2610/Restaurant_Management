<article id="<%= dom_id(card) %>" class="overflow-hidden rounded-[16px] border bg-white shadow-sm transition hover:shadow-md <%= card.unread? ? "border-[#8f1f2a]/30 ring-1 ring-[#8f1f2a]/10" : "border-[#d7b9b2]/70" %>">
  <div class="flex items-start gap-4 p-5">
    <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full <%= card.unread? ? "bg-[#8f1f2a]/10 text-[#8f1f2a]" : "bg-[#eef3ec] text-[#3ea12b]" %>">
      <% if card.unread? %>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      <% else %>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      <% end %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="font-serif text-lg font-semibold leading-snug text-[#2f1f1d]"><%= card.title %></h2>
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-[0.08em] <%= card.unread? ? "bg-[#8f1f2a] text-white" : "bg-[#e3f0e0] text-[#2e7d26]" %>">
          <%= card.unread? ? "New" : "Read" %>
        </span>
      </div>
      <% if card.body.present? %>
        <p class="mt-1.5 text-sm leading-relaxed text-[#4a3633]"><%= card.body %></p>
      <% else %>
        <p class="mt-1.5 text-sm italic text-[#a0817d]">No additional details.</p>
      <% end %>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#8a6f6b]">
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <%= card.created_at.strftime("%b %d, %Y") %> · <%= card.created_at.strftime("%I:%M %p") %>
        </span>
        <span><%= time_ago_in_words(card.created_at) %> ago</span>
        <span class="inline-flex items-center rounded-full bg-[#f4e6e2] px-2.5 py-0.5 font-semibold text-[#7a5550]">#<%= card.id %></span>
      </div>
    </div>
    <% if card.unread? %>
      <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#8f1f2a]" title="Unread"></span>
    <% end %>
  </div>
  <% if card.unread? %>
    <div class="h-1 w-full bg-gradient-to-r from-[#8f1f2a] to-[#d4756a]"></div>
  <% end %>
</article>