<div class="min-h-screen bg-[#f4e6e2] px-6 pb-16 pt-28 text-[#2f1f1d]">
  <%= turbo_stream_from current_user %>
  <div class="mx-auto max-w-3xl">
    <!-- Page header -->
    <header class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#8f1f2a]">Notifications</p>
      <h1 class="mt-2 font-serif text-4xl font-semibold text-[#2f1f1d]">Your Updates</h1>
      <div class="mt-4 h-1 w-16 rounded-full bg-[#8f1f2a]"></div>
    </header>

    <!-- Summary -->
    <div class="flex justify-between items-center mb-5">
      <div class="flex items-center gap-3 text-sm text-[#7a5a56]">
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[#8f1f2a]"></span>
          <strong class="text-[#2f1f1d]"><%= @notifications.unread.count %></strong> unread
        </span>
        <span>·</span>
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-[#c8a49a]"></span>
          <strong class="text-[#2f1f1d]"><%= @notifications.read.count %></strong> read
        </span>
      </div>

      <div>
        <% if current_user.notifications.unread.exists? %>
          <%= button_to "Mark all as read", mark_all_read_notifications_path, method: :patch, class: "px-4 py-2 rounded-md bg-[#8F000D] text-white hover:bg-[#8F000D]/90" %>
        <% end %>
      </div>
    </div>

    <div id="notifications-list" class="space-y-4">
      <% if @notifications.empty? %>
        <!-- Empty state -->
        <div class="rounded-lg border border-[#d7b9b2]/60 bg-white p-12 text-center shadow-sm">
          <span class="text-5xl">🔔</span>
          <p class="mt-5 font-serif text-xl font-semibold text-[#2f1f1d]">No notifications yet</p>
          <p class="mt-2 text-sm text-[#7a5a56]">When you receive updates they will show up here.</p>
        </div>
      <% else %>
        <%= render @notifications %>
      <% end %>
    </div>
  </div>
</div>
