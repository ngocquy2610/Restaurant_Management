<% content_for :title, "New Waste Report" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/kitchen_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[900px]">
        <%= link_to "Back to reports", kitchen_waste_reports_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.6rem] leading-none">New Waste Report</h2>
        <div class="mt-6 rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
          <%= render "form", waste_report: @waste_report, ingredients: @ingredients %>
        </div>
      </div>
    </main>
  </div>
</div>
