<% content_for :title, "Request ##{@low_stock_request.id}" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/kitchen_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[900px]">
        <%= render "layouts/flash" %>
        <%= link_to "Back to requests", kitchen_low_stock_requests_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.6rem] leading-none">Request #<%= @low_stock_request.id %></h2>
        <dl class="mt-6 space-y-3 rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Ingredient</dt><dd class="font-semibold"><%= @low_stock_request.ingredient.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Urgency</dt><dd><%= low_stock_request_urgency_badge(@low_stock_request.urgency) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Status</dt><dd><%= low_stock_request_status_badge(@low_stock_request.status) %></dd></div>
          <div><dt class="text-[#7a5a56]">Note</dt><dd class="mt-1 rounded-md bg-[#f1e3df] px-4 py-3 text-sm"><%= @low_stock_request.note.presence || "—" %></dd></div>
          <% if @low_stock_request.review_note.present? %>
            <div><dt class="text-[#7a5a56]">Review note</dt><dd class="mt-1 rounded-md bg-[#f1e3df] px-4 py-3 text-sm"><%= @low_stock_request.review_note %></dd></div>
          <% end %>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Reviewed at</dt><dd><%= @low_stock_request.reviewed_at ? inventory_time(@low_stock_request.reviewed_at) : "—" %></dd></div>
        </dl>
      </div>
    </main>
  </div>
</div>
