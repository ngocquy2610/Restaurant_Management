<% content_for :title, "Inventory Overview" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1260px]">
        <%= render "layouts/flash" %>
        <h2 class="font-serif text-[3rem] leading-none tracking-[-0.06em]">Inventory Overview</h2>
        <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Stock levels, open restock work, and pending reviews.</p>
        <div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-2">
          <section class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-serif text-[1.4rem] font-semibold">Needs restock</h3>
              <%= link_to "Manage ingredients", ingredients_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
            </div>
            <% if @low_stock_ingredients.any? %>
              <ul class="divide-y divide-[#e4d6d2]">
                <% @low_stock_ingredients.each do |ingredient| %>
                  <li class="flex items-center justify-between gap-3 py-3">
                    <div><p class="font-semibold"><%= ingredient.name %></p>
                    <p class="text-sm text-[#7a5a56]"><%= inventory_quantity(ingredient.current_quantity, ingredient.unit) %> / threshold <%= inventory_quantity(ingredient.low_stock_threshold, ingredient.unit) %></p></div>
                    <%= ingredient_status_badge(ingredient.status) %>
                  </li>
                <% end %>
              </ul>
            <% else %><p class="rounded-md bg-[#f1e3df] px-4 py-3 text-sm text-[#7a5a56]">All ingredients above threshold.</p><% end %>
          </section>
          <section class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-serif text-[1.4rem] font-semibold">Open restock tasks</h3>
              <%= link_to "All tasks", inventory_restock_tasks_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
            </div>
            <% if @open_restock_tasks.any? %>
              <ul class="divide-y divide-[#e4d6d2]">
                <% @open_restock_tasks.first(8).each do |task| %>
                  <li class="flex items-center justify-between gap-3 py-3">
                    <div><p class="font-semibold"><%= link_to task.ingredient.name, inventory_restock_task_path(task), class: "hover:underline" %></p>
                    <p class="text-sm text-[#7a5a56]"><%= inventory_quantity(task.quantity, task.ingredient.unit) %> - <%= task.source.humanize %></p></div>
                    <%= restock_task_status_badge(task.status) %>
                  </li>
                <% end %>
              </ul>
            <% else %><p class="rounded-md bg-[#f1e3df] px-4 py-3 text-sm text-[#7a5a56]">No open tasks.</p><% end %>
          </section>
          <section class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-serif text-[1.4rem] font-semibold">Pending requests</h3>
              <%= link_to "All requests", inventory_low_stock_requests_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
            </div>
            <% if @pending_requests.any? %>
              <ul class="divide-y divide-[#e4d6d2]">
                <% @pending_requests.first(8).each do |r| %>
                  <li class="flex items-center justify-between gap-3 py-3">
                    <div><p class="font-semibold"><%= link_to r.ingredient.name, inventory_low_stock_request_path(r), class: "hover:underline" %></p>
                    <p class="text-sm text-[#7a5a56]">by <%= r.user.full_name %> - <%= inventory_time(r.created_at) %></p></div>
                    <%= low_stock_request_status_badge(r.status) %>
                  </li>
                <% end %>
              </ul>
            <% else %><p class="rounded-md bg-[#f1e3df] px-4 py-3 text-sm text-[#7a5a56]">No pending requests.</p><% end %>
          </section>
          <section class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-serif text-[1.4rem] font-semibold">Pending waste</h3>
              <%= link_to "All reports", inventory_waste_reports_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
            </div>
            <% if @pending_waste_reports.any? %>
              <ul class="divide-y divide-[#e4d6d2]">
                <% @pending_waste_reports.first(8).each do |w| %>
                  <li class="flex items-center justify-between gap-3 py-3">
                    <div><p class="font-semibold"><%= link_to w.ingredient.name, inventory_waste_report_path(w), class: "hover:underline" %></p>
                    <p class="text-sm text-[#7a5a56]"><%= inventory_quantity(w.quantity, w.ingredient.unit) %> - <%= inventory_time(w.created_at) %></p></div>
                    <%= waste_report_status_badge(w.status) %>
                  </li>
                <% end %>
              </ul>
            <% else %><p class="rounded-md bg-[#f1e3df] px-4 py-3 text-sm text-[#7a5a56]">No pending waste.</p><% end %>
          </section>
        </div>
      </div>
    </main>
  </div>
</div>
