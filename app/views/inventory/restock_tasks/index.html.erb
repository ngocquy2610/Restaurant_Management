<% content_for :title, "Restock Tasks" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1260px]">
        <%= render "layouts/flash" %>
        <h2 class="font-serif text-[3rem] leading-none tracking-[-0.06em]">Restock Tasks</h2>
        <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Work queue for replenishing ingredients.</p>
        <div class="mt-6 overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
          <table class="w-full text-left text-sm">
            <thead class="bg-[#f1e3df] text-[0.72rem] uppercase tracking-[0.14em] text-[#9b6a63]">
              <tr><th class="px-5 py-3">Ingredient</th><th class="px-5 py-3">Qty</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Source</th><th class="px-5 py-3">Due</th><th class="px-5 py-3"></th></tr>
            </thead>
            <tbody class="divide-y divide-[#e4d6d2]">
              <% @restock_tasks.each do |task| %>
                <tr>
                  <td class="px-5 py-3 font-semibold"><%= link_to task.ingredient.name, inventory_restock_task_path(task), class: "hover:underline" %></td>
                  <td class="px-5 py-3"><%= inventory_quantity(task.quantity, task.ingredient.unit) %></td>
                  <td class="px-5 py-3"><%= restock_task_status_badge(task.status) %></td>
                  <td class="px-5 py-3"><%= restock_task_source_badge(task.source) %></td>
                  <td class="px-5 py-3 text-[#7a5a56]"><%= task.due_on ? inventory_time(task.due_on) : "—" %></td>
                  <td class="px-5 py-3 text-right">
                    <% if policy(task).advance? && !task.completed? && !task.cancelled? %>
                      <%= button_to "Complete", advance_inventory_restock_task_path(task), method: :patch, class: "cursor-pointer rounded-md bg-[#7b1f2a] px-3 py-2 text-xs font-semibold text-white hover:bg-[#661a23]" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @restock_tasks.empty? %>
            <p class="px-5 py-6 text-sm text-[#7a5a56]">No restock tasks yet.</p>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>
