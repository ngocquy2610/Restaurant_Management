<% content_for :title, "Restock Task ##{@restock_task.id}" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[900px]">
        <%= render "layouts/flash" %>
        <%= link_to "Back to tasks", inventory_restock_tasks_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.6rem] leading-none">Restock #<%= @restock_task.id %></h2>
        <dl class="mt-6 space-y-3 rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Ingredient</dt><dd class="font-semibold"><%= @restock_task.ingredient.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Quantity</dt><dd class="font-semibold"><%= inventory_quantity(@restock_task.quantity, @restock_task.ingredient.unit) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Status</dt><dd><%= restock_task_status_badge(@restock_task.status) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Source</dt><dd><%= restock_task_source_badge(@restock_task.source) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Due</dt><dd><%= @restock_task.due_on ? inventory_time(@restock_task.due_on) : "—" %></dd></div>
          <% if @restock_task.low_stock_request.present? %>
            <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">From request</dt><dd><%= link_to "Request ##{@restock_task.low_stock_request_id}", inventory_low_stock_request_path(@restock_task.low_stock_request), class: "font-semibold text-[#7b1f2a] hover:underline" %></dd></div>
          <% end %>
          <% if @restock_task.waste_report.present? %>
            <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">From waste</dt><dd><%= link_to "Report ##{@restock_task.waste_report_id}", inventory_waste_report_path(@restock_task.waste_report), class: "font-semibold text-[#7b1f2a] hover:underline" %></dd></div>
          <% end %>
        </dl>
        <% if policy(@restock_task).advance? && !@restock_task.completed? && !@restock_task.cancelled? %>
          <div class="mt-4">
            <%= button_to "Mark completed", advance_inventory_restock_task_path(@restock_task), method: :patch, class: "cursor-pointer rounded-md bg-[#7b1f2a] px-5 py-3 font-semibold text-white hover:bg-[#661a23]" %>
          </div>
        <% end %>
      </div>
    </main>
  </div>
</div>
