<% content_for :title, "Refill Restock Task ##{@restock_task.id}" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[720px]">
        <%= render "layouts/flash" %>
        <%= link_to "Back to task", inventory_restock_task_path(@restock_task), class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.4rem] leading-none">Receive stock</h2>
        <p class="mt-3 text-[1.05rem] text-[#7a5a56]">
          <%= @restock_task.ingredient.name %> —
          planned <%= inventory_quantity(@restock_task.quantity, @restock_task.ingredient.unit) %>
        </p>

        <%= form_with url: complete_inventory_restock_task_path(@restock_task), method: :patch,
              scope: :restock_task, class: "mt-6 space-y-5" do |f| %>
          <div>
            <%= f.label :received_quantity, "Quantity received (#{@restock_task.ingredient.unit})",
                  class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.number_field :received_quantity, step: 0.01, min: 0.01,
                  value: @restock_task.quantity,
                  class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
          </div>
          <div>
            <%= f.label :supplier, class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.text_field :supplier, placeholder: "e.g. Fresh Foods Co.",
                  class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] placeholder:text-[#7a5d5a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
          </div>
          <div>
            <%= f.label :note, class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.text_area :note, rows: 3, placeholder: "Delivery note / batch info",
                  class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] placeholder:text-[#7a5d5a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
          </div>
          <%= f.submit "Complete restock",
                class: "cursor-pointer rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
        <% end %>
      </div>
    </main>
  </div>
</div>
