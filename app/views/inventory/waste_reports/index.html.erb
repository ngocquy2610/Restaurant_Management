<% content_for :title, "Waste Reports" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1260px]">
        <%= render "layouts/flash" %>
        <h2 class="font-serif text-[3rem] leading-none tracking-[-0.06em]">Waste Reports</h2>
        <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Verify reported waste before it hits the ledger.</p>

        <div class="mt-5 flex flex-wrap gap-2">
          <% [["All", nil], ["Pending", "pending"], ["Approved", "approved"], ["Rejected", "rejected"]].each do |label, val| %>
            <%= link_to label, inventory_waste_reports_path(status: val),
                  class: "rounded-full px-4 py-2 text-sm font-semibold #{params[:status] == val ? 'bg-[#7b1f2a] text-white' : 'bg-[#f1e3df] text-[#5c4543] hover:bg-[#e9d4d0]'}" %>
          <% end %>
        </div>

        <div class="mt-5 overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
          <table class="w-full text-left text-sm">
            <thead class="bg-[#f1e3df] text-[0.72rem] uppercase tracking-[0.14em] text-[#9b6a63]">
              <tr><th class="px-5 py-3">Ingredient</th><th class="px-5 py-3">Qty</th><th class="px-5 py-3">From</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Sent</th><th class="px-5 py-3"></th></tr>
            </thead>
            <tbody class="divide-y divide-[#e4d6d2]">
              <% @waste_reports.each do |report| %>
                <tr>
                  <td class="px-5 py-3 font-semibold"><%= link_to report.ingredient.name, inventory_waste_report_path(report), class: "hover:underline" %></td>
                  <td class="px-5 py-3"><%= inventory_quantity(report.quantity, report.ingredient.unit) %></td>
                  <td class="px-5 py-3"><%= report.user&.full_name || "System" %></td>
                  <td class="px-5 py-3"><%= waste_report_status_badge(report.status) %></td>
                  <td class="px-5 py-3 text-[#7a5a56]"><%= inventory_time(report.created_at) %></td>
                  <td class="px-5 py-3 text-right"><%= link_to "Verify", inventory_waste_report_path(report), class: "font-semibold text-[#7b1f2a] hover:underline" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @waste_reports.empty? %>
            <p class="px-5 py-6 text-sm text-[#7a5a56]">No waste reports yet.</p>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>
