<% content_for :title, "Stock Adjustment" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[720px]">
        <%= render "layouts/flash" %>
        <%= link_to "Back to ingredients", ingredients_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.6rem] leading-none">Stock Adjustment</h2>
        <p class="mt-3 text-[1.05rem] text-[#7a5a56]">
          Enter the physical count. The difference posts to the ledger as an ADJUSTMENT entry.
        </p>

        <%= form_with url: inventory_stock_adjustments_path, scope: :stock_adjustment,
              class: "mt-6 space-y-5",
              data: { controller: "stock-adjustment",
                      stock_adjustment_quantities_value: @quantities.to_json } do |f| %>
          <div>
            <%= f.label :ingredient_id, "Ingredient", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.collection_select :ingredient_id, @ingredients, :id, :name,
                  { selected: @selected, prompt: "Select an ingredient" },
                  class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]",
                  data: { stock_adjustment_target: "select", action: "change->stock-adjustment#recompute" } %>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]">System quantity</p>
              <p class="rounded-md bg-[#f1e3df] px-4 py-3 font-semibold text-[#2f1f1d]" data-stock-adjustment-target="system">—</p>
            </div>
            <div>
              <%= f.label :physical_count, "Physical count", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
              <%= f.number_field :physical_count, step: 0.01, min: 0, value: @physical_count,
                    placeholder: "0.00",
                    class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]",
                    data: { stock_adjustment_target: "physical", action: "input->stock-adjustment#recompute" } %>
            </div>
          </div>

          <div class="rounded-md bg-[#f1e3df] px-4 py-3">
            <span class="text-sm text-[#7a5a56]">Difference preview: </span>
            <span class="font-semibold text-[#7a5a56]" data-stock-adjustment-target="difference">—</span>
          </div>

          <div>
            <%= f.label :reason, "Reason", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.text_area :reason, rows: 3, value: @reason,
                  placeholder: "e.g. Weekly stocktake, spoilage found",
                  class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] placeholder:text-[#7a5d5a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
          </div>

          <%= f.submit "Confirm adjustment",
                data: { stock_adjustment_target: "submit" },
                class: "cursor-pointer rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
        <% end %>
      </div>
    </main>
  </div>
</div>
