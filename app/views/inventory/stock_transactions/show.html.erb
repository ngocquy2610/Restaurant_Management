<% content_for :title, "Transaction ##{@stock_transaction.id}" %>
<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[900px]">
        <%= render "layouts/flash" %>
        <%= link_to "Back to transactions", inventory_stock_transactions_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <h2 class="mt-3 font-serif text-[2.6rem] leading-none">Transaction #<%= @stock_transaction.id %></h2>
        <dl class="mt-6 space-y-3 rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Ingredient</dt><dd class="font-semibold"><%= @stock_transaction.ingredient.name %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Type</dt><dd><%= stock_transaction_type_badge(@stock_transaction.transaction_type) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Quantity</dt><dd class="font-semibold"><%= inventory_quantity(@stock_transaction.quantity, @stock_transaction.ingredient.unit) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Before / After</dt><dd class="font-semibold"><%= inventory_quantity(@stock_transaction.quantity_before) %> / <%= inventory_quantity(@stock_transaction.quantity_after) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Reason</dt><dd><%= @stock_transaction.reason.presence || "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Reference</dt><dd><%= @stock_transaction.reference.presence || "—" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">By</dt><dd><%= @stock_transaction.user&.full_name || "System" %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[#7a5a56]">Time</dt><dd><%= inventory_time(@stock_transaction.created_at) %></dd></div>
        </dl>
      </div>
    </main>
  </div>
</div>
