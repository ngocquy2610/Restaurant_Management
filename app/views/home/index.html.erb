<div class="min-h-screen bg-[#f4e6e2] text-[#2f1f1d]">
  <!-- ============================================================
       HERO / COVER — promotion image slider
       ============================================================ -->
  <section class="relative">
    <div class="relative h-[560px] w-full overflow-hidden sm:h-[640px]" data-controller="promo-slider" data-promo-slider-interval-value="4500">
      <!-- Default cover slide (always shown first) -->
      <div data-promo-slider-target="slide" class="promo-slide is-visible">
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/default_cover.jpeg');"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#2f1f1d]/90 via-[#2f1f1d]/35 to-transparent"></div>

        <div class="absolute inset-0 flex items-end justify-center pb-16 sm:items-center sm:pb-0">
          <div class="mx-6 max-w-2xl rounded-[12px] bg-black/50 py-6 px-12 text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#e8c9c2]">Welcome to Lumière Dining</p>
            <h1 class="mt-5 font-serif text-4xl font-semibold leading-tight text-white sm:text-6xl">A Symphony of Flavors, A Legacy of Taste</h1>
            <p class="mt-5 text-lg text-[#f1e3df]/85">Experience the timeless art of French fine dining in the heart of the city.</p>
            <%= link_to reservations_path, class: "mt-8 inline-flex items-center gap-2 rounded-sm bg-[#8f1f2a] px-8 py-3.5 text-sm font-semibold uppercase tracking-[0.12em] text-white shadow-lg transition hover:bg-[#7a1a23]" do %>
              Book a Table
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            <% end %>
          </div>
        </div>
      </div>

      <% @promotions.each do |promo| %>
        <div data-promo-slider-target="slide" class="promo-slide">
          <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('<%= url_for(promo.image) %>');"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#2f1f1d]/90 via-[#2f1f1d]/35 to-transparent"></div>

          <div class="absolute inset-0 flex items-end justify-center pb-16 sm:items-center sm:pb-0">
            <div class="mx-6 max-w-2xl rounded-[12px] bg-black/50 py-6 px-12 text-center">
              <% if promo.discount_type == "percentage" %>
                <span class="mb-4 inline-flex items-center rounded-full bg-[#8f1f2a] px-4 py-1.5 text-sm font-semibold uppercase tracking-[0.08em] text-white shadow-sm"><%= number_to_currency(promo.discount_value, precision: 0, unit: "") %>% OFF</span>
              <% else %>
                <span class="mb-4 inline-flex items-center rounded-full bg-[#8f1f2a] px-4 py-1.5 text-sm font-semibold uppercase tracking-[0.08em] text-white shadow-sm">$<%= number_to_currency(promo.discount_value, precision: 0, unit: "") %> OFF</span>
              <% end %>

              <h1 class="font-serif text-3xl font-semibold leading-tight text-white drop-shadow-lg sm:text-5xl"><%= promo.name %></h1>

              <p class="mt-4 text-[1.05rem] text-[#f1e3df]/90">
                <%= l(promo.start_date, format: :short) if promo.start_date %> - <%= l(promo.end_date, format: :short) if promo.end_date %>
              </p>

              <%= link_to tables_path(), class: "mt-7 inline-flex items-center gap-2 rounded-sm bg-[#8f1f2a] px-8 py-3.5 text-sm font-semibold uppercase tracking-[0.12em] text-white shadow-lg transition hover:bg-[#7a1a23]" do %>
                Book a Table
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <% if @promotions.any? %>
        <div class="relative z-10" data-promo-slider-target="controls">
          <button type="button" data-action="promo-slider#prev"
                  class="absolute left-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur transition hover:bg-white/35"
                  aria-label="Previous promotion">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" data-action="promo-slider#next"
                  class="absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur transition hover:bg-white/35"
                  aria-label="Next promotion">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      <% end %>

      <div class="absolute inset-x-0 bottom-5 z-10 flex items-center justify-center gap-2">
        <button type="button" data-promo-slider-target="dot" data-index="0" data-action="promo-slider#dot"
                class="promo-slider-dot h-2.5 w-2.5 rounded-full bg-[#d8c1bc] transition-all is-active"
                aria-label="Go to slide 1"></button>
        <% @promotions.each_with_index do |promo, index| %>
          <button type="button" data-promo-slider-target="dot" data-index="<%= index + 1 %>" data-action="promo-slider#dot"
                  class="promo-slider-dot h-2.5 w-2.5 rounded-full bg-[#d8c1bc] transition-all"
                  aria-label="Go to slide <%= index + 2 %>"></button>
        <% end %>
      </div>
    </div>
  </section>

  <!-- ============================================================
       OUR PHILOSOPHY
       ============================================================ -->
  <section class="bg-[#f8f3f1]">
    <div class="mx-auto grid w-full max-w-[1200px] items-center gap-12 px-6 py-20 sm:px-10 md:grid-cols-2">
      <div>
        <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">Our Philosophy</h2>
        <div class="mt-4 h-1 w-16 rounded-full bg-[#8f1f2a]"></div>
        <p class="mt-7 leading-relaxed text-[#5c443f]">
          Rooted in the rich culinary heritage of the French countryside, Lumière Dining was founded on the belief that a meal is more than sustenance—it is a gathering, a celebration, and a memory in the making.
        </p>
        <p class="mt-4 leading-relaxed text-[#5c443f]">
          We source only the finest, locally grown ingredients, combining them with time-honored techniques to bring you dishes that are deeply comforting yet flawlessly refined. Step into our dining room and feel the warmth of our heart.
        </p>
        <%= link_to "Discover Our Heritage", menus_path, class: "mt-8 inline-block rounded-sm border border-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-[#8f1f2a] transition hover:bg-[#8f1f2a] hover:text-white" %>
      </div>

      <div class="relative">
        <div class="aspect-[4/3] w-full overflow-hidden rounded-[16px] shadow-xl">
          <%= image_tag "/images.jpeg", class: "h-full w-full object-cover", alt: "Lumière Dining kitchen" %>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SIGNATURES OF THE HOUSE — featured dishes
       ============================================================ -->
  <section class="bg-[#f4e6e2]">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-20 sm:px-10">
      <div class="text-center">
        <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">Signatures of the House</h2>
        <p class="mt-3 text-[#7a5a56]">A curated selection of our most beloved dishes, prepared with passion and precision.</p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <% if @featured_foods.empty? %>
          <div class="col-span-full rounded-[16px] border-2 border-dashed border-[#d7b9b2] bg-[#f8f3f1] p-10 text-center text-[#7a5a56]">
            Our signature dishes are being prepared. Please check the full menu.
          </div>
        <% else %>
          <% @featured_foods.each do |food| %>
            <div class="overflow-hidden rounded-[16px] border border-[#e3cdc8] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
              <div class="relative h-52 w-full">
                <% if food.image.attached? %>
                  <%= image_tag food.image, class: "h-full w-full object-cover", alt: food.name %>
                <% else %>
                  <div class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-[#f1e3df] to-[#d7b9b2]">
                    <span class="text-5xl">🍽️</span>
                  </div>
                <% end %>
                <% if food.category.present? %>
                  <span class="absolute left-4 top-4 rounded-full bg-[#8f1f2a]/95 px-3 py-1 text-xs font-semibold uppercase tracking-[0.08em] text-white shadow"><%= food.category.name %></span>
                <% end %>
              </div>
              <div class="p-6">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-serif text-xl font-semibold"><%= food.name %></h3>
                  <span class="font-serif text-lg text-[#8f1f2a]"><%= number_to_currency(food.base_price, unit: "$") %></span>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-[#7a5a56]"><%= truncate(food.description, length: 120) %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="mt-12 text-center">
        <%= link_to "View Full Menu", menus_path, class: "inline-block rounded-sm border border-[#8f1f2a] bg-white px-8 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-[#8f1f2a] transition hover:bg-[#8f1f2a] hover:text-white" %>
      </div>
    </div>
  </section>

  <!-- ============================================================
       AN ATMOSPHERE OF ELEGANCE — gallery
       ============================================================ -->
  <section class="bg-[#f8f3f1]">
    <div class="mx-auto grid w-full max-w-[1200px] items-center gap-12 px-6 py-20 sm:px-10 md:grid-cols-2">
      <div class="order-2 md:order-1">
        <h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">An Atmosphere of Elegance</h2>
        <div class="mt-4 h-1 w-16 rounded-full bg-[#8f1f2a]"></div>
        <p class="mt-7 leading-relaxed text-[#5c443f]">
          Designed to reflect the warmth of a traditional French manor, our dining room features plush seating, soft candle lighting, and intimate corners perfect for quiet conversations and celebratory toasts.
        </p>
        <%= link_to "Reserve Your Table", reservations_path, class: "mt-8 inline-block rounded-sm border border-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.1em] text-[#8f1f2a] transition hover:bg-[#8f1f2a] hover:text-white" %>
      </div>

      <div class="order-1 grid h-72 grid-cols-3 grid-rows-2 gap-3 sm:h-80 md:order-2 md:h-[420px]">
        <% gallery_tiles = [
             { img: "/Fine-dining-in-Hanoi-01_1687944552.webp", label: "Wine Cellar",  span: "col-span-2 row-span-2" },
             { img: "/Fine-dining-in-Hanoi-04_1687944496.webp", label: "Dining Room", span: "col-span-1 row-span-1" },
             { img: "/Fine-dining-in-Hanoi-banner.jpg",        label: "Private Room", span: "col-span-1 row-span-1" }
           ] %>
        <% gallery_tiles.each do |tile| %>
          <div class="<%= tile[:span] %> relative overflow-hidden rounded-[12px] shadow-md">
            <%= image_tag tile[:img], class: "h-full w-full object-cover", alt: tile[:label] %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/5 to-transparent"></div>
            <p class="absolute bottom-3 left-3 text-xs font-semibold uppercase tracking-[0.18em] text-white"><%= tile[:label] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>  
</div>
