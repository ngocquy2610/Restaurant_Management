<div class="pt-20 bg-[#f4e6e2] text-[#2f1f1d]">
  <section class="mx-auto w-full max-w-[1200px] px-6 py-20 sm:px-10">
    <div class="rounded-[28px] border border-[#e5d2cd] bg-white p-8 shadow-sm sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#8f1f2a]">Contact</p>
      <h1 class="mt-4 font-serif text-4xl font-bold sm:text-5xl">Contact Us</h1>
      <div class="mt-4 h-1 w-20 rounded-full bg-[#8f1f2a]"></div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div class="space-y-6">
          <div class="rounded-2xl bg-[#f9f3f1] p-6">
            <h2 class="font-serif text-2xl font-semibold">Visit Lumière Dining</h2>
            <p class="mt-3 text-[#5d4543]">12 Bản Cấm Street, Hoàn Kiếm District, Hà Nội</p>
            <p class="mt-1 text-[#5d4543]">Open daily · 5:30 PM – 11:30 PM</p>
          </div>

          <div class="rounded-2xl bg-[#f9f3f1] p-6">
            <h2 class="font-serif text-2xl font-semibold">Speak with our team</h2>
            <p class="mt-3 text-[#5d4543]">Phone: +84 (0) 24 555 0188</p>
            <p class="mt-1 text-[#5d4543]">Email: hello@lumieredining.vn</p>
          </div>
        </div>

        <div class="rounded-2xl border border-[#ead8d2] bg-[#2f1f1d] p-8 text-[#f7eae5]">
          <h2 class="font-serif text-2xl font-semibold">We’d love to hear from you</h2>
          <p class="mt-4 leading-relaxed text-[#e6c8c2]">
            Whether you’re planning a romantic dinner, a private celebration, or a question about our menu,
            our team is here to help.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <%= link_to "Reserve a Table", reservations_path,
                  class: "inline-block rounded-sm bg-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7a1a23]" %>
            <%= link_to "View Menu", menus_path,
                  class: "inline-block rounded-sm border border-[#d7b7b1] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-white hover:text-[#2f1f1d]" %>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
