<div class="pt-20 bg-[#f4e6e2] text-[#2f1f1d]">
  <section class="mx-auto w-full max-w-[1200px] px-6 py-20 sm:px-10">
    <div class="rounded-[28px] border border-[#e5d2cd] bg-white p-8 shadow-sm sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#8f1f2a]">Join our team</p>
      <h1 class="mt-4 font-serif text-4xl font-bold sm:text-5xl">Careers</h1>
      <div class="mt-4 h-1 w-20 rounded-full bg-[#8f1f2a]"></div>

      <p class="mt-8 max-w-3xl text-lg leading-relaxed text-[#5d4543]">
        At Lumière Dining, we believe hospitality is an art form. We are building a team of thoughtful,
        curious, and passionate people who care deeply about crafting memorable experiences for every guest.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% [
          { title: "Front of House", body: "Guest-facing hosts, servers, and coordinators who shape every warm welcome." },
          { title: "Kitchen", body: "Chefs, cooks, and culinary creatives who elevate every plate with precision and care." },
          { title: "Operations", body: "Support specialists who keep service smooth, thoughtful, and beautifully organized." }
        ].each do |role| %>
          <div class="rounded-2xl bg-[#f9f3f1] p-6">
            <h2 class="font-serif text-2xl font-semibold"><%= role[:title] %></h2>
            <p class="mt-3 text-sm leading-relaxed text-[#5d4543]"><%= role[:body] %></p>
          </div>
        <% end %>
      </div>

      <div class="mt-10 rounded-2xl border border-[#ead8d2] bg-[#2f1f1d] p-8 text-[#f7eae5]">
        <h2 class="font-serif text-2xl font-semibold">We’re always looking for hospitality champions.</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-[#e6c8c2]">
          Send your CV to careers@lumieredining.vn and tell us which role or department you’d like to join.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <%= link_to "Contact Us", contact_us_path,
                class: "inline-block rounded-sm bg-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7a1a23]" %>
          <%= link_to "Explore Menu", menus_path,
                class: "inline-block rounded-sm border border-[#d7b7b1] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-white hover:text-[#2f1f1d]" %>
        </div>
      </div>
    </div>
  </section>
</div>
