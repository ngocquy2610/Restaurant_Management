<div class="pt-20 bg-[#f4e6e2] text-[#2f1f1d]">
  <section class="mx-auto w-full max-w-[1200px] px-6 py-20 sm:px-10">
    <div class="rounded-[28px] border border-[#e5d2cd] bg-white p-8 shadow-sm sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#8f1f2a]">Privacy</p>
      <h1 class="mt-4 font-serif text-4xl font-bold sm:text-5xl">Privacy Policy</h1>
      <div class="mt-4 h-1 w-20 rounded-full bg-[#8f1f2a]"></div>

      <div class="mt-10 space-y-8 text-[#5d4543]">
        <div>
          <h2 class="font-serif text-2xl font-semibold text-[#2f1f1d]">1. Information we collect</h2>
          <p class="mt-3 leading-relaxed">
            We may collect information such as your name, email address, phone number, reservation details,
            and preferences when you visit our restaurant, make a booking, or contact us.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-semibold text-[#2f1f1d]">2. How we use it</h2>
          <p class="mt-3 leading-relaxed">
            We use your information to manage reservations, improve service quality, send important updates,
            and support your dining experience.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-semibold text-[#2f1f1d]">3. Protection</h2>
          <p class="mt-3 leading-relaxed">
            We take reasonable technical and organizational steps to protect personal information from unauthorized access,
            loss, or misuse.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-2xl font-semibold text-[#2f1f1d]">4. Contact</h2>
          <p class="mt-3 leading-relaxed">
            If you have any questions about your information or this policy, please contact us at hello@lumieredining.vn.
          </p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <%= link_to "Contact Us", contact_us_path,
              class: "inline-block rounded-sm bg-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#7a1a23]" %>
        <%= link_to "Home", root_path,
              class: "inline-block rounded-sm border border-[#8f1f2a] px-6 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-[#8f1f2a] transition hover:bg-[#8f1f2a] hover:text-white" %>
      </div>
    </div>
  </section>
</div>
