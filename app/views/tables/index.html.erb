<% content_for :title, "Restaurant Tables" %>



<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">

    <% tables = @area ? @area.tables.to_a : [] %>
    <% available   = tables.count(&:available?) %>
    <% occupied    = tables.count(&:occupied?) %>
    <% reserved    = tables.count(&:reserved?) %>
    <% out_of_svc  = tables.count(&:out_of_service?) %>
    <% total_cap   = tables.sum { |t| t.capacity.to_i } %>

    <!-- Page header -->
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Floor Management</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">
          <%= @area ? @area.name : "Restaurant Tables" %>
        </h1>
        <p class="mt-4 text-sm text-gray-600">A live floor plan of your dining room. Select a dining area to inspect its tables at a glance.</p>
      </div>

      <% if current_user&.admin? %>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <%= link_to "Add Table",
                      new_table_path,
                      class: "inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
          <%= link_to "Add Area",
                      new_area_path,
                      class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          <% if @area %>
            <%= link_to "Edit Area", edit_area_path(id: @area.id), class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
            <%= link_to "Delete", area_path(@area),
              data: { turbo_method: :delete, turbo_confirm: "Delete this area and all its tables?" },
              class: "text-red-600 inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold shadow-sm transition hover:bg-gray-50" %>
          <%end%>
        </div>
      <% end %>
    </div>

    <!-- Area navigation -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">Dining areas</span>
      <% @areas.each do |area| %>
        <% active = area.id == @area&.id %>
        <%= link_to area.name,
                    tables_path(area_id: area.id),
                    class: active \
                      ? "inline-flex items-center rounded-full bg-[#8A1C2B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition" \
                      : "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-[#FAF5F1] hover:border-[#8A1C2B]/30" %>
      <% end %>

      <span class="mx-1 hidden h-6 w-px bg-gray-300 sm:block"></span>

      <% if @prev_area %>
        <%= link_to "← Previous",
                    tables_path(area_id: @prev_area.id),
                    class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
      <% else %>
        <span class="inline-flex cursor-not-allowed items-center rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-gray-300">← Previous</span>
      <% end %>

      <% if @next_area %>
        <%= link_to "Next →",
                    tables_path(area_id: @next_area.id),
                    class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
      <% else %>
        <span class="inline-flex cursor-not-allowed items-center rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-gray-300">Next →</span>
      <% end %>

      
    </div>

    <% if @area %>

      <!-- Stat cards -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Tables</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">🍽️</span>
          </div>
          <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= tables.size %></p>
          <p class="mt-2 text-xs font-semibold text-gray-400">in <%= @area.name %></p>
        </div>

        <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Total Seats</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">🪑</span>
          </div>
          <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= total_cap %></p>
          <p class="mt-2 text-xs font-semibold text-gray-400">combined capacity</p>
        </div>

        <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Occupied</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-red-100 text-lg">🔴</span>
          </div>
          <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= occupied %></p>
          <p class="mt-2 text-xs font-semibold <%= occupied.positive? ? "text-red-600" : "text-gray-400" %>">
            <%= occupied.positive? ? "▲ in service" : "all clear" %>
          </p>
        </div>

        <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Available</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-green-100 text-lg">🟢</span>
          </div>
          <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= available %></p>
          <p class="mt-2 text-xs font-semibold text-green-600"><%= reserved %> reserved · <%= out_of_svc %> out of service</p>
        </div>
      </div>

      <!-- Floor map -->
      <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 px-6 py-5">
          <h2 class="font-serif text-2xl font-semibold text-gray-900"><%= @area.name %> — Floor Plan</h2>

          <div class="flex flex-wrap items-center gap-4">
            <% ["available", "occupied", "reserved", "out_of_service"].each do |s| %>
              <span class="inline-flex items-center gap-2 text-xs font-semibold text-gray-600">
                <span class="h-3 w-3 rounded-full <%= status_dot_class(s) %>"></span>
                <%= status_label(s) %>
              </span>
            <% end %>
          </div>
        </div>

        <div class="p-6">
          <div data-controller="floor-map"
               data-floor-map-area-value="<%= { id: @area.id, name: @area.name, width: 1200, height: 700, image: (@area.image.attached? ? url_for(@area.image) : nil) }.to_json %>"
               data-floor-map-tables-value="<%= @tables_payload.to_json %>">
            <div id="konva-stage-container"
                 class="w-full overflow-x-auto rounded-2xl flex justify-center"></div>
          </div>

          <% if tables.empty? %>
            <p class="mt-6 py-4 text-center text-sm text-gray-500">No tables have been placed in this area yet.</p>
          <% end %>
        </div>
      </div>

      <!-- Table listing -->
      <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
          <h2 class="font-serif text-2xl font-semibold text-gray-900">Tables in <%= @area.name %></h2>
          <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]"><%= tables.size %> tables</span>
        </div>

        <% if tables.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm text-gray-700">
              <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
                <tr>
                  <th scope="col" class="px-6 py-4">Table</th>
                  <th scope="col" class="px-6 py-4">Type</th>
                  <th scope="col" class="px-6 py-4">Shape</th>
                  <th scope="col" class="px-6 py-4">Seats</th>
                  <th scope="col" class="px-6 py-4">Status</th>
                  <th scope="col" class="px-6 py-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <% tables.sort_by(&:table_number).each do |table| %>
                  <tr class="transition hover:bg-[#FAF5F1]">
                    <td class="px-6 py-5">
                      <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 font-serif text-base font-bold text-[#8A1C2B]">
                          <%= table.table_number %>
                        </div>
                        <p class="text-sm font-semibold text-gray-900">Table <%= table.table_number %></p>
                      </div>
                    </td>
                    <td class="px-6 py-5 text-sm text-gray-600"><%= table.table_type&.type || "—" %></td>
                    <td class="px-6 py-5 text-sm text-gray-600"><%= shape_label(table.shape) %></td>
                    <td class="px-6 py-5 text-sm text-gray-600"><%= table.capacity %> seats</td>
                    <td class="px-6 py-5">
                      <span class="inline-flex items-center gap-2 rounded-full <%= status_chip_class(table.status) %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= status_meta(table.status)[:text] %>">
                        <span class="h-2 w-2 rounded-full <%= status_dot_class(table.status) %>"></span>
                        <%= status_label(table.status) %>
                      </span>
                    </td>
                    <td class="px-6 py-5 text-right">
                      <% if current_user&.admin? %>
                        <%= link_to "Edit", edit_table_path(table), class: "inline-flex rounded-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
                        <%= link_to "Delete", table_path(table, area_id: @area&.id),
                          data: { turbo_method: :delete, turbo_confirm: "Delete this table?"},
                          class: "inline-flex rounded-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
                      <% end %>
                    </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="px-6 py-10 text-center text-sm text-gray-500">No tables configured in this area yet.</p>
        <% end %>
      </div>
    <% else %>
      <!-- Empty state -->
      <div class="rounded-[2rem] border border-dashed border-gray-300 bg-white px-6 py-16 text-center shadow-sm">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-3xl">🍽️</div>
        <h2 class="mt-6 font-serif text-2xl font-semibold text-gray-900">No dining areas yet</h2>
        <p class="mt-3 text-sm text-gray-600">Create a dining area to start mapping out your restaurant's tables.</p>
        <% if current_user&.admin? %>
          <%= link_to "Add your first table", new_table_path, class: "mt-6 inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

