<% content_for :title, "Restaurant Layout" %>

<div class="px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-3xl"><%= @area ? @area.name : "Restaurant Layout" %></h1>

    <div class="flex items-center gap-2">
      <% if @prev_area %>
        <%= link_to "← Prev",
                    tables_path(area_id: @prev_area.id),
                    class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 text-gray-800 font-medium" %>
      <% else %>
        <span class="rounded-md px-3.5 py-2.5 bg-gray-100 text-gray-300 font-medium cursor-not-allowed">← Prev</span>
      <% end %>

      <% if @next_area %>
        <%= link_to "Next →",
                    tables_path(area_id: @next_area.id),
                    class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 text-gray-800 font-medium" %>
      <% else %>
        <span class="rounded-md px-3.5 py-2.5 bg-gray-100 text-gray-300 font-medium cursor-not-allowed">Next →</span>
      <% end %>
    </div>
  </div>

  <% if @area %>
    <div data-controller="floor-map"
         data-floor-map-area-value="<%= { id: @area.id, name: @area.name, width: 1000, height: 700 }.to_json %>"
         data-floor-map-tables-value="<%= @tables_payload.to_json %>">
      <div id="konva-stage-container"
           class="border border-gray-300 rounded-lg overflow-hidden shadow-sm w-full"></div>
    </div>
  <% else %>
    <p class="text-center text-gray-500 py-16">No areas have been created yet.</p>
  <% end %>
</div>
