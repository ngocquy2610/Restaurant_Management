<% content_for :title, "Editing table" %>

<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 pt-28">
  <div class="w-full">
    <div class="flex gap-6">
      <%= render "layouts/admin_sidebar" %>

      <main class="flex-1">
        <div class="max-w-4xl rounded-[2rem] border border-gray-200 bg-white p-8 shadow-sm">
          <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/70">Floor management</p>
              <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-gray-900">Editing table</h1>
            </div>
            <%= link_to "Back to dashboard", admin_dashboards_path, class: "inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
          </div>

          <%= render "form", table: @table %>

          <div class="mt-6 flex flex-wrap gap-3">
            <%= link_to "Show this table", @table, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
            <%= link_to "Back to tables", tables_path, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>
        </div>
      </main>
    </div>
  </div>
</div>
