<% content_for :title, "New table" %>

<div class="min-h-screen bg-[#FBF0EC] px-4 pb-10 pt-28 sm:px-6 lg:px-8">
  <div class="w-full">
    <div class="admin-flex flex flex-col gap-4 md:flex-row md:gap-6">
      <% if current_user&.admin? || current_user&.receptionist? %>
      <%= render "layouts/admin_sidebar" %>
    <% end %>

      <main class="w-full min-w-0 max-w-full flex-1">
        <%= render "layouts/admin_mobile_nav" %>
        <div class="max-w-4xl rounded-[2rem] border border-gray-200 bg-white p-8 shadow-sm">
          <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/70">Floor management</p>
              <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-gray-900">New table</h1>
            </div>
            <%= link_to "Back to dashboard", admin_dashboards_path, class: "inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
          </div>

          <%= render "form", table: @table %>

          <%= link_to "Back to tables", tables_path, class: "mt-4 inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
        </div>
      </main>
    </div>
  </div>
</div>
