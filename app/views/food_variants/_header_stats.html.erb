<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9b6a63]">Menu structure</p>
    <h2 class="font-serif text-[2.75rem] leading-none tracking-tight text-[#2f1f1d]">Menu Variants</h2>
    <p class="mt-2 text-[1.05rem] text-[#7a5a56]"><%= pluralize(@total_variants, "variant") %> total · <%= pluralize(@total_dishes, "dish") %> with variants · <%= pluralize(@food_variants.total_count, "result") %><%= @query.present? ? " for \u201C#{@query}\u201D" : "" %></p>
  </div>
  <% if policy(FoodVariant.new).create? %>
    <%= link_to new_food_variant_path, class: "inline-flex items-center gap-2 rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" do %><span class="text-lg leading-none">＋</span> New Variant<% end %>
  <% end %>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Total variants</p>
    <p class="mt-1 font-serif text-4xl font-semibold"><%= @total_variants %></p>
    <p class="mt-1 text-sm text-[#7a5a56]">Showing <%= @food_variants.size %> of <%= @food_variants.total_count %> (8 per page)</p>
  </div>
  <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Dishes covered</p>
    <p class="mt-1 font-serif text-4xl font-semibold"><%= @total_dishes %></p>
    <p class="mt-1 text-sm text-[#7a5a56]">Distinct dishes with a variant</p>
  </div>
  <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Avg. adjustment</p>
    <p class="mt-1 font-serif text-4xl font-semibold"><%= @avg_adjustment ? "#{@avg_adjustment >= 0 ? "+" : "−"}$#{number_to_currency(@avg_adjustment.abs, precision: 2, unit: "")}" : "—" %></p>
    <p class="mt-1 text-sm text-[#7a5a56]">Mean adjustment vs. base price</p>
  </div>
</div>
