<% content_for :title, "Food Variants" %>

<div class="min-h-screen pt-[5.25rem] bg-[#f4e6e2] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <aside class="sticky top-[5.25rem] z-10 h-[calc(100vh-5.25rem)] w-[270px] shrink-0 self-start overflow-y-auto border-r border-[#d8b6af] bg-[#f8eeee] px-5 py-6">

      <nav class="space-y-2">
        <%= link_to categories_path, class: "flex items-center gap-3 rounded-md px-3 py-3 text-[1.05rem] font-medium text-[#5c4543] hover:bg-[#f1e0dc]" do %>
          <span class="flex h-5 w-5 items-center justify-center">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </span>
          <span>Categories Management</span>
        <% end %>

        <%= link_to foods_path, class: "flex items-center gap-3 rounded-md px-3 py-3 text-[1.05rem] font-medium text-[#5c4543] hover:bg-[#f1e0dc]" do %>
          <span class="flex h-5 w-5 items-center justify-center">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h.01M12 3h.01M17 3h.01"/><path d="M7 21h10"/><path d="M7 3c0 5-3 8-3 11a3 3 0 0 0 6 0c0-3-3-6-3-11"/><path d="M17 3c0 5-3 8-3 11a3 3 0 0 0 6 0c0-3-3-6-3-11"/></svg>
          </span>
          <span>Foods Management</span>
        <% end %>

        <%= link_to food_variants_path, class: "flex items-center gap-3 rounded-md bg-[#e9d4d0] px-3 py-3 text-[1.05rem] font-medium text-[#5a1a1b] shadow-inner" do %>
          <span class="flex h-5 w-5 items-center justify-center">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v5M12 21v-4M12 16v-8"/><circle cx="12" cy="7" r="2"/><circle cx="12" cy="17" r="2"/><path d="M7 6v2M7 8v6a2 2 0 0 0 2 2h0"/><circle cx="7" cy="5" r="2"/><path d="M17 6v2M17 8v6a2 2 0 0 1-2 2h0"/><circle cx="17" cy="5" r="2"/></svg>
          </span>
          <span>Food Variant Management</span>
        <% end %>
      </nav>

      <div class="mt-6 border-t border-[#d8b6af] pt-5">
        <p class="mb-3 px-3 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Add New</p>
        <div class="space-y-2">
          <%= link_to new_food_variant_path, class: "flex items-center gap-3 rounded-md px-3 py-3 text-[1.05rem] font-medium text-[#5c4543] hover:bg-[#f1e0dc]" do %>
            <span class="flex h-5 w-5 items-center justify-center text-[#7b1f2a]">＋</span>
            <span>Add New Variant</span>
          <% end %>
        </div>
      </div>

      <div class="mt-6 border-t border-[#d8b6af] pt-5">
        <%= link_to "Back to dashboard", admin_dashboards_path, class: "flex justify-center items-center gap-3 rounded-md bg-[#7b1f2a] px-3 py-3 text-[1.05rem] font-semibold text-white shadow-sm hover:bg-[#661a23]"%>
      </div>
    </aside>

    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1260px]">

        <% if notice.present? %>
          <p class="mb-5 inline-block rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-600" id="notice"><%= notice %></p>
        <% end %>

        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-serif text-[4rem] leading-none tracking-[-0.06em] text-[#2f1f1d]">Menu Variants</h2>
            <p class="mt-3 text-[1.15rem] text-[#7a5a56]">Manage portions, sizes, and price points for each dish.</p>
          </div>

        </div>

        <div id="food_variants" class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
          <% if @food_variants.any? %>
            <% @food_variants.each do |food_variant| %>
              <% food = food_variant.food %>
              <% food_name = food&.name.to_s.truncate(18) %>
              <%= link_to food_variant_path(food_variant), class: "group block rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
                <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-[12px] bg-[#f1e3df] text-[#7b1f2a]">
                  <% case food&.category&.name.to_s.downcase %>
                  <% when /starter|appetizer/ %>
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h12"/><path d="M9 5h6v7a3 3 0 0 1-6 0V5Z"/><path d="M9 19h6"/></svg>
                  <% when /main|course|dish/ %>
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M7 7h10v10H7z"/><path d="M9 4v3M15 4v3"/></svg>
                  <% when /dessert|sweet/ %>
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14c0-2 1.5-3.5 5-3.5s5 1.5 5 3.5v2.5H7z"/><path d="M9 14V9c0-1.7 1.1-3 3-3s3 1.3 3 3v5"/><path d="M6 18h12"/></svg>
                  <% when /wine|drink|beverage/ %>
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v7a5 5 0 0 1-10 0z"/><path d="M9 19h6"/><path d="M12 15v4"/><path d="M7 9h10"/></svg>
                  <% else %>
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v5M12 21v-4M12 16v-8"/><circle cx="12" cy="7" r="2"/><circle cx="12" cy="17" r="2"/><path d="M7 6v2M7 8v6a2 2 0 0 0 2 2h0"/><circle cx="7" cy="5" r="2"/><path d="M17 6v2M17 8v6a2 2 0 0 1-2 2h0"/><circle cx="17" cy="5" r="2"/></svg>
                  <% end %>
                </div>

                <h3 class="font-serif text-[1.7rem] font-semibold tracking-tight text-[#2f1f1d]"><%= food_variant.name %></h3>

                <div class="mt-5 flex items-center justify-center gap-3 text-[0.9rem] text-[#5e4b48]">
                  <span>$<%= number_to_currency(food_variant.final_price, precision: 2, unit: "") %></span>
                  <span class="inline-flex items-center rounded-full bg-[#6a4c4b] px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-white">
                    <%= food_name.presence || "Dish" %>
                  </span>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="col-span-full flex min-h-[360px] items-center justify-center rounded-[16px] border-2 border-dashed border-[#d7b9b2] bg-[#f8f3f1]">
              <div class="max-w-md text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[#f1e3df] text-3xl">🍽️</div>
                <h3 class="font-serif text-[2.2rem] font-semibold tracking-tight text-[#2f1f1d]">No variants yet</h3>
                <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Start by adding the first variant for this dish.</p>
                <%= link_to "Add First Variant", new_food_variant_path, class: "mt-6 inline-flex items-center justify-center rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>
