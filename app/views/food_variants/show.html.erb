<% content_for :title, @food_variant.name %>

<%
  food = @food_variant.food
  food_name = food&.name || "Unknown dish"
  base_price = food&.base_price
  price_adjustment = @food_variant.price_adjustment || 0
  final_price = @food_variant.final_price rescue (base_price && base_price + price_adjustment)
%>

<div class="min-h-screen bg-[#f4e6e2] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[860px] flex-col px-6 py-12">
    <%= link_to food_variants_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to menu variants
    <% end %>

    <% if notice.present? %>
      <div class="mb-6 rounded-md border border-[#bcd9b4] bg-[#eef7ea] px-4 py-3 text-[#3f7d2f]" id="notice"><%= notice %></div>
    <% end %>

    <div class="overflow-hidden rounded-[18px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
      <%= render "show_header", food: food, food_name: food_name %>

      <%= render "show_body", food: food, food_name: food_name, base_price: base_price, price_adjustment: price_adjustment, final_price: final_price %>

      <%= render "show_extra", food: food, food_name: food_name, base_price: base_price, price_adjustment: price_adjustment, final_price: final_price %>
    </div>
  </main>
</div>

