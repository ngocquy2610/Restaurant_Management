<% content_for :title, "New food variant" %>

<div class="pt-[5.25rem] min-h-screen bg-[#f4e6e2] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[1080px] flex-col px-6 py-12">
    <%= link_to food_variants_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to menu variants
    <% end %>

    <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#9b6a63]">Menu structure · New</p>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-[#2f1f1d]">New food variant</h1>
      <p class="mt-2 text-[1.05rem] text-[#7a5a56]">Add a new size or portion for one of your dishes. Final price = base ± adjustment.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_300px]">
      <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-8 shadow-sm">
        <%= render "form", food_variant: @food_variant %>
      </div>

      <aside class="space-y-4">
        <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">How pricing works</p>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[#5b4a48]">
            <li><strong>1.</strong> Pick the dish — its base price is shown instantly.</li>
            <li><strong>2.</strong> Set the adjustment: <em>+2.50</em> surcharge, <em>−1.00</em> discount, <em>0</em> same price.</li>
            <li><strong>3.</strong> The live preview shows the final price before you save.</li>
          </ul>
        </div>
        <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Rules</p>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[#5b4a48]">
            <li>· Variant name must be unique per dish.</li>
            <li>· Final price must stay at or above $0.</li>
            <li>· A dish is required.</li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</div>
