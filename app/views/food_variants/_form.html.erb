<%= form_with(model: food_variant, class: "space-y-6",
      data: { controller: "food-variant-form", food_variant_form_prices_value: (@foods.to_h { |f| [f.id.to_s, f.base_price.to_s] }).to_json }) do |form| %>
  <% if food_variant.errors.any? %>
    <div id="error_explanation" role="alert" class="mb-6 rounded-[12px] border border-[#e5b3ad] bg-[#fbe9e6] px-5 py-4 text-[#8f1f2a]">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <h2 class="font-semibold"><%= pluralize(food_variant.errors.count, "error") %> prohibited this variant from being saved:</h2>
      </div>
      <ul class="mt-2 list-disc space-y-0.5 pl-7 text-[0.95rem]">
        <% food_variant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "form_preview", food_variant: food_variant,
        selected_food: @foods.find { |f| f.id.to_s == food_variant.food_id.to_s } %>

  <%= render "form_fields_top", form: form, food_variant: food_variant,
        grouped: @foods.group_by { |f| f.category&.name || "Uncategorized" } %>

  <%= render "form_fields_bottom", form: form, food_variant: food_variant %>
<% end %>

