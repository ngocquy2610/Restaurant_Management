<%= form_with(model: food_variant, class: "space-y-6") do |form| %>
  <% if food_variant.errors.any? %>
    <div id="error_explanation" class="mb-6 rounded-md border border-[#e5b3ad] bg-[#fbe9e6] px-4 py-3 text-[#8f1f2a]">
      <h2 class="font-semibold"><%= pluralize(food_variant.errors.count, "error") %> prohibited this food variant from being saved:</h2>
      <ul class="mt-1 list-disc pl-5">
        <% food_variant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :name, "Variant name", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
      <%= form.text_field :name,
            placeholder: "e.g. Small, Large, Regular, Family",
            class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] placeholder:text-[#7a5d5a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
    </div>

    <div>
      <%= form.label :food_id, "Food", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
      <%= form.collection_select :food_id, @foods, :id, :name,
            { prompt: "Select a food" },
            class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :price_adjustment, "Price adjustment", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
      <div class="relative">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#7a5d5a]">$</span>
        <%= form.number_field :price_adjustment,
              step: 0.01, placeholder: "e.g. 2.50 (or -2.00 to discount)",
              class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] py-3 pl-8 pr-4 text-[1rem] text-[#2c1c1a] placeholder:text-[#7a5d5a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
      </div>
      <p class="mt-2 text-sm text-[#7a5d5a]">Added to (or subtracted from) the food's base price to produce the final price.</p>
    </div>
  </div>

  <div class="flex items-center gap-3 border-t border-[#e4d2ce] pt-6">
    <%= form.submit class: "cursor-pointer rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
    <%= link_to "Cancel", food_variants_path, class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 text-base font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
  </div>
<% end %>

