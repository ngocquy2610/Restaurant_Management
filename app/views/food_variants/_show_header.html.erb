<div class="border-b border-[#eadcd8] bg-[#7b1f2a] px-8 py-6">
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to "Variants", food_variants_path, class: "rounded-full bg-white/15 px-3 py-1 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white/90 hover:bg-white/25" %>
    <span class="text-white/50">/</span>
    <% if food.present? %>
      <%= link_to food_name, food_path(food), class: "rounded-full bg-white/15 px-3 py-1 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white/90 hover:bg-white/25" %>
    <% else %>
      <span class="rounded-full bg-white/15 px-3 py-1 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white/90"><%= food_name %></span>
    <% end %>
    <span class="text-white/50">/</span>
    <span class="rounded-full bg-white px-3 py-1 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-[#7b1f2a]"><%= @food_variant.name %></span>
  </div>
  <% if food&.category.present? %>
    <p class="mt-3 text-sm text-white/70">Category: <strong class="text-white"><%= food.category.name %></strong> · Variant ID #<%= @food_variant.id %></p>
  <% else %>
    <p class="mt-3 text-sm text-white/70">Variant ID #<%= @food_variant.id %></p>
  <% end %>
</div>
