<%# Flash messages shared by the inventory/kitchen consoles. %>
<% if notice.present? %>
  <script>
    Toastify({
      text: "<%= j notice %>",
      className: "toastify-toast success",
      duration: 3000,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      close: true
    }).showToast();
  </script>
<% end %>
<% if alert.present? %>
  <script>
    Toastify({
      text: "<%= j alert %>",
      className: "toastify-toast warning",
      duration: 4000,
      gravity: "top",
      position: "right",
      stopOnFocus: true,
      close: true
    }).showToast();
  </script>
<% end %>
