<aside class="sticky top-[5.25rem] z-10 h-[calc(100vh-5.25rem)] w-[270px] shrink-0 self-start overflow-y-auto border-r border-[#d8b6af] bg-[#f8eeee] px-5 py-6">
  <p class="mb-3 px-3 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Inventory</p>

  <nav class="space-y-2">
    <%= link_to inventory_root_path, class: sidebar_nav_class(inventory_root_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      </span>
      <span>Overview</span>
    <% end %>

    <%= link_to ingredients_path, class: sidebar_nav_class(ingredients_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 8h10v3H7z"/><path d="M5 8h14"/><path d="M8 3h8M9 11v8h6v-8"/></svg>
      </span>
      <span>Ingredients Management</span>
    <% end %>

    <%= link_to inventory_stock_transactions_path, class: sidebar_nav_class(inventory_stock_transactions_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13l4 4-4 4H4z"/><path d="M4 7v10"/></svg>
      </span>
      <span>Stock Transactions</span>
    <% end %>

    <%= link_to inventory_reports_path, class: sidebar_nav_class(inventory_reports_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/></svg>
      </span>
      <span>Inventory Report</span>
    <% end %>

    <%= link_to inventory_restock_tasks_path, class: sidebar_nav_class(inventory_restock_tasks_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11l4 4-4 4H4z"/><path d="M9 11h7"/></svg>
      </span>
      <span>Restock Tasks</span>
    <% end %>

    <%= link_to inventory_low_stock_requests_path, class: sidebar_nav_class(inventory_low_stock_requests_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
      </span>
      <span>Low Stock Requests</span>
    <% end %>

    <%= link_to inventory_waste_reports_path, class: sidebar_nav_class(inventory_waste_reports_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l-1 13H6z"/><path d="M9 7V4h6v3"/></svg>
      </span>
      <span>Waste Reports</span>
    <% end %>
  </nav>

  <div class="mt-6 border-t border-[#d8b6af] pt-5">
    <% if current_user.admin? %>
      <%= link_to "Back to dashboard", admin_dashboards_path,
            class: "flex justify-center items-center rounded-md bg-[#7b1f2a] px-3 py-3 text-[1.05rem] font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
    <% else %>
      <%= link_to "Back to home", root_path,
            class: "flex justify-center items-center rounded-md bg-[#7b1f2a] px-3 py-3 text-[1.05rem] font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
    <% end %>
  </div>
</aside>
