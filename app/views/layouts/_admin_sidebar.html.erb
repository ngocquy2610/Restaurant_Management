<aside class="admin-sidebar sticky top-[5.25rem] z-10 h-[calc(100vh-5.25rem)] w-[270px] shrink-0 self-start overflow-y-auto border-r border-[#d8b6af] bg-[#f8eeee] px-0 py-6"
      data-admin-sidebar="true">
  <div class="flex items-center justify-between px-5 pb-3">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Management</p>
    <button type="button"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-[#8A1C2B] transition hover:bg-[#8A1C2B]/10 md:hidden"
            data-action="click->mobile-nav#close"
            aria-label="Close admin menu">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav class="space-y-2 pt-3">
    <% if current_user&.admin? %>
    <%= link_to admin_dashboards_path, class: sidebar_nav_class(admin_dashboards_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12.5 12 4l9 8.5"/><path d="M5 10.5V20h14v-9.5"/></svg>
      </span>
      <span>Overview</span>
    <% end %>

    <%= link_to performance_admin_dashboards_path(from_date: @from_date, to_date: @to_date), class: sidebar_nav_class(performance_admin_dashboards_path(from_date: @from_date, to_date: @to_date)) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/></svg>
      </span>
      <span>Restaurant Performance</span>
    <% end %>
    <% end %>

    <% if current_user&.admin? || current_user&.receptionist? %>
    <%= link_to tables_path, class: sidebar_nav_class(tables_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18"/><path d="M5 10V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M7 10v8m10-8v8M3 18h18"/></svg>
      </span>
      <span>Tables</span>
    <% end %>
    <% end %>

    <% if current_user&.admin? %>
    <%= link_to admin_users_path, class: sidebar_nav_class(admin_users_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19v-1a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v1"/><circle cx="10" cy="7" r="3"/><path d="M20 19v-1a4 4 0 0 0-3-3.87"/><path d="M16 4.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span>User Management</span>
    <% end %>
    <% end %>

    <% if current_user&.admin? || current_user&.receptionist? %>
    <%= link_to admin_reservations_path, class: sidebar_nav_class(admin_reservations_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
      </span>
      <span>Reservations</span>
    <% end %>

    <%= link_to admin_customer_queues_path, class: sidebar_nav_class(admin_customer_queues_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19v-1a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v1"/><circle cx="10" cy="7" r="3"/><path d="M21 11h-6"/></svg>
      </span>
      <span>Customer Queue</span>
    <% end %>
    <% end %>

    <% if current_user&.admin? %>
    <%= link_to categories_path, class: sidebar_nav_class(categories_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.5 12 3l9 4.5-9 4.5L3 7.5Z"/><path d="M3 12.5 12 17l9-4.5"/><path d="M3 17.5 12 22l9-4.5"/></svg>
      </span>
      <span>Menu Management</span>
    <% end %>

    <%= link_to promotions_path, class: sidebar_nav_class(promotions_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="m17 6-5-3-5 3 5 3 5-3Z"/><path d="m17 12-5 3-5-3 5-3 5 3Z"/><path d="m17 18-5 3-5-3 5-3 5 3Z"/></svg>
      </span>
      <span>Promotions</span>
    <% end %>

    <%= link_to inventory_reports_path, class: sidebar_nav_class(inventory_reports_path) do %>
      <span class="flex h-5 w-5 items-center justify-center">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M4 19h17"/><path d="m7 15 4-4 3 2 6-7"/></svg>
      </span>
      <span>Inventory Reports</span>
    <% end %>
    <% end %>
  </nav>
</aside>
