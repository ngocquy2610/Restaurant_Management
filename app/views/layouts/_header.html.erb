<nav class="fixed top-0 left-0 w-full z-30 flex items-center justify-between gap-3 px-4 py-4 sm:px-8 sm:py-6 bg-[#FFF8F6] border">
  <div class="flex min-w-0 items-center gap-2 sm:gap-3">
    <% sidebar_page = request.path.start_with?("/admin", "/inventory", "/kitchen") || controller.controller_path.start_with?("admin/", "inventory", "kitchen") || %w[categories foods food_variants ingredients recipe_items promotions tables dashboards users reservations customer_queues].include?(controller.controller_name) %>
    <% if sidebar_page %>
      <button type="button"
              data-admin-menu-toggle
              data-action="click->mobile-nav#toggle"
              class="flex h-10 w-10 items-center justify-center rounded-full border border-[#d8b6af] bg-[#f8eeee] text-[#8A1C2B] transition hover:bg-[#8A1C2B]/10 md:hidden"
              aria-label="Open admin menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    <% end %>
    <% sidebar_page = request.path.start_with?("/admin", "/inventory", "/kitchen") || controller.controller_path.start_with?("admin/", "inventory", "kitchen") || %w[categories foods food_variants ingredients recipe_items promotions tables dashboards users reservations customer_queues].include?(controller.controller_name) %>
    <span class="truncate font-serif text-xl font-bold text-[#8F000D] sm:text-3xl"><%= link_to "Lumière Dining", root_path%></span>
  </div>
  <div class="hidden md:flex gap-10 text-black">
    <%= link_to "Menu", menus_path %>
    <%= link_to "Our Story", our_story_path %>
    <%= link_to "Reviews", reviews_path %>
    <%= link_to "Reservation", reservations_path %>
    <% if current_user && policy(Order).index? %>
      <%= link_to "Orders", orders_path %>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <div data-controller="dropdown" class="relative md:hidden">
      <button
        type="button"
        data-action="click->dropdown#toggle keydown->dropdown#onKeydown"
        class="flex items-center gap-2 rounded-full border border-[#d8b6af] bg-[#f8eeee] px-4 py-2 text-sm font-bold text-[#8A1C2B] transition hover:bg-[#8A1C2B]/10"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Site menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span>Menu</span>
      </button>

      <div
        data-dropdown-target="menu"
        class="absolute right-0 top-full mt-2 hidden w-56 origin-top-right rounded-lg border border-black/10 bg-white py-2 shadow-lg"
        role="menu"
      >
        <p class="px-4 pb-2 text-xs font-semibold uppercase tracking-widest text-gray-400">Explore</p>
        <%= link_to "Menu", menus_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <%= link_to "Our Story", our_story_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <%= link_to "Reviews", reviews_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <%= link_to "Reservation", reservations_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <% if current_user && policy(Order).index? %>
          <%= link_to "Orders", orders_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <% end %>
      </div>
    </div>
    <% if current_user %>
      <%= turbo_stream_from current_user %>
      <%= link_to notifications_path do %>
        <div class="relative flex items-center justify-center rounded-full p-2 text-[#8F000D] transition hover:bg-black/5 hover:cursor-pointer">
          <%= render "notifications/bell_badge", user: current_user %>

          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
      <% end %>
    <% end %>

    <div data-controller="dropdown" class="relative">
      <button
        type="button"
        data-action="click->dropdown#toggle keydown->dropdown#onKeydown"
        class="flex items-center justify-center rounded-full p-2 text-[#8F000D] transition hover:bg-black/5 hover:cursor-pointer"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Account"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0 1 12 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </button>

      <div
        data-dropdown-target="menu"
        class="absolute right-0 top-full mt-2 hidden w-52 origin-top-right rounded-lg border border-black/10 bg-white py-2 shadow-lg"
        role="menu"
      >
        <% if current_user %>
          <%= link_to "My Profile", user_path(current_user), class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% if current_user.waiter? %>
            <p class="mt-1 border-t border-gray-100 px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-widest text-gray-400">Waiter Console</p>
            <%= link_to "New order", new_order_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "All orders", orders_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Menu", menus_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to "Dashboard", admin_dashboards_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Customer queue", admin_customer_queues_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Kitchen queue", admin_kitchen_queues_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.inventory_manager? %>
            <%= link_to "Inventory console", inventory_root_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.kitchen_staff? %>
            <%= link_to "Kitchen requests", kitchen_root_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.kitchen_staff? %>
            <%= link_to "Kitchen queue", admin_kitchen_queues_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.receptionist? %>
            <%= link_to "Floor plan", reservations_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Tables", tables_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Manage reservations", admin_reservations_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
            <%= link_to "Customer queue", admin_customer_queues_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block w-full px-4 py-2 text-left text-sm text-gray-800 hover:bg-amber-50" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <%= link_to "Create account", new_user_registration_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>