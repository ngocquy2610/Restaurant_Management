<nav class="fixed top-0 left-0 w-full z-30 flex items-center justify-between px-8 py-6 bg-[#FFF8F6] border">
  <span class="text-[#8F000D] font-serif text-3xl font-bold"><%= link_to "Lumière Dining", root_path%></span>
  <div class="flex gap-10 text-black">
    <%= link_to "Menu", menus_path %>
    <a href="#">Our Story</a>
    <%= link_to "Reservation", reservations_path %>
    <% if current_user && !current_user.customer? %>
      <%= link_to "Orders", orders_path %>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <% if current_user&.waiter? %>
      <div data-controller="dropdown" class="relative">
        <button
          type="button"
          data-action="click->dropdown#toggle keydown->dropdown#onKeydown"
          class="flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-[#8F000D] transition hover:bg-black/5"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Waiter menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v4a3 3 0 0 0 6 0V3m-6 4h12M5 7a7 5 0 0 0 14 0" />
            <path stroke-linecap="round" d="M5 5h14" />
          </svg>
          Waiter
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
        </button>

        <div
          data-dropdown-target="menu"
          class="absolute right-0 top-full mt-2 hidden w-52 origin-top-right rounded-lg border border-black/10 bg-white py-2 shadow-lg"
          role="menu"
        >
          <p class="px-4 pb-2 text-xs font-semibold uppercase tracking-widest text-gray-400">Waiter Console</p>
          <%= link_to "New order", new_order_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <%= link_to "All orders", orders_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <%= link_to "Menu", menus_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        </div>
      </div>
    <% end %>

    <% if current_user %>
      <%= turbo_stream_from current_user %>
      <%= link_to notifications_path do %>
        <div class="relative flex items-center justify-center rounded-full p-2 text-[#8F000D] transition hover:bg-black/5 hover:cursor-pointer">
          <%= render "notifications/bell_badge", user: current_user %>

          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
        </div>
      <% end %>
    <% end %>

    <div data-controller="dropdown" class="relative">
      <button
        type="button"
        data-action="click->dropdown#toggle keydown->dropdown#onKeydown"
        class="flex items-center justify-center rounded-full p-2 text-[#8F000D] transition hover:bg-black/5 hover:cursor-pointer"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Account"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0 1 12 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </button>

      <div
        data-dropdown-target="menu"
        class="absolute right-0 top-full mt-2 hidden w-52 origin-top-right rounded-lg border border-black/10 bg-white py-2 shadow-lg"
        role="menu"
      >
        <% if current_user %>
          <%= link_to "My Profile", user_path(current_user), class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% if current_user.admin? %>
            <%= link_to "Dashboard", admin_dashboards_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <% if current_user.receptionist? %>
            <%= link_to "Manage reservations", admin_reservations_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <% end %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block w-full px-4 py-2 text-left text-sm text-gray-800 hover:bg-amber-50" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
          <%= link_to "Create account", new_user_registration_path, class: "block px-4 py-2 text-sm text-gray-800 hover:bg-amber-50" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>