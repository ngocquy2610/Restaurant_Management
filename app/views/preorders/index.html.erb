<% content_for :title, "Pre-orders" %>
<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-6xl space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Kitchen &amp; Floor</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Pre-orders</h1>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>

    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">All Pre-orders</h2>
        <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]"><%= @orders.size %> pre-orders</span>
      </div>

      <% if @orders.any? %>
        <table class="min-w-full text-left text-sm text-gray-700">
          <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
            <tr>
              <th scope="col" class="px-6 py-4">Guest</th>
              <th scope="col" class="px-6 py-4">Table</th>
              <th scope="col" class="px-6 py-4">Dishes</th>
              <th scope="col" class="px-6 py-4 text-right">Estimated total</th>
              <th scope="col" class="px-6 py-4 text-right">Placed</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @orders.each do |order| %>
              <tr class="transition hover:bg-[#FAF5F1]">
                <td class="px-6 py-5">
                  <p class="font-semibold text-gray-900"><%= order.reservation&.guest_name %></p>
                  <% if order.reservation&.user.present? %>
                    <p class="mt-1 text-xs text-gray-500"><%= order.reservation.user.full_name %></p>
                  <% end %>
                </td>
                <td class="px-6 py-5 text-gray-600">Table <%= order.table&.table_number %></td>
                <td class="px-6 py-5 text-gray-600"><%= pluralize(order.order_items.size, "dish") %></td>
                <td class="px-6 py-5 text-right font-medium text-gray-900"><%= number_to_currency(order.total_price, precision: 2) %></td>
                <td class="px-6 py-5 text-right text-gray-500"><%= order.created_at&.strftime("%d %b · %I:%M %p") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-12 text-center text-sm text-gray-500">No pre-orders yet.</p>
      <% end %>
    </div>
  </div>
</div>
