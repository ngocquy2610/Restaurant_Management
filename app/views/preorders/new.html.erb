<% content_for :title, "Pre-order your table" %>
<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-4xl space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Pre-Order</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Choose your dishes</h1>
      <p class="mt-4 text-sm text-gray-600">Pick what you'd like ready when you arrive — you'll settle the bill on-site.</p>
    </div>

    <% if @order.reservation.present? %>
      <div class="flex flex-wrap items-center gap-4 rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 font-serif text-base font-bold text-[#8A1C2B]">
          <%= (@order.reservation.table&.table_number || "?").upcase %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900">Table <%= @order.reservation.table&.table_number %></p>
          <p class="mt-1 text-xs text-gray-500">
            <%= @order.reservation.reservation_date %> ·
            <%= @order.reservation.reservation_time&.strftime("%I:%M %p") %> ·
            <%= @order.reservation.guest_name %>
          </p>
        </div>
      </div>
    <% end %>

    <% if @order.errors.any? %>
      <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
        <h2 class="mb-1 font-semibold"><%= pluralize(@order.errors.count, "error") %> prohibited this pre-order from being saved:</h2>
        <ul class="list-disc pl-5">
          <% @order.errors.full_messages.uniq.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <%= form_with(model: @order, url: @order.reservation.present? ? reservation_preorders_path(@order.reservation) : reservations_path,
            class: "contents", data: { controller: "order-form", order_form_variants: h(@variants_by_food.to_json) }) do |form| %>
        <%= form.hidden_field :reservation_id %>

        <div class="mb-4 flex items-center justify-between">
          <h3 class="font-serif text-2xl font-semibold text-gray-900">Food &amp; Drinks</h3>
          <span class="text-xs text-gray-500">Pick a dish, then a variation only if it has one.</span>
        </div>

        <div data-order-form-target="items" class="space-y-3"></div>

        <button type="button" data-action="click->order-form#addItem"
                class="mt-4 inline-flex items-center gap-2 rounded-md border border-[#8A1C2B] bg-white px-4 py-2 text-sm font-semibold text-[#8A1C2B] transition hover:bg-[#8A1C2B] hover:text-white">
          + Add dish
        </button>

        <template data-order-form-target="template">
          <%= render "orders/item_row", prefix: "order[order_items_attributes][__INDEX__]", item: nil %>
        </template>

        <div class="mt-8 flex items-center gap-3">
          <%= form.submit "Place pre-order", class: "rounded-md bg-[#8A1C2B] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#6d1420]" %>
          <%= link_to @order.reservation.present? ? "Skip for now" : "Back",
                @order.reservation.present? ? reservation_path(@order.reservation) : reservations_path,
                class: "text-sm font-semibold text-gray-500 hover:text-[#8A1C2B]" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
