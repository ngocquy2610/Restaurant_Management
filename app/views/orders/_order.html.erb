<div id="<%= dom_id order %>" class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 font-serif text-base font-bold text-[#8A1C2B]">
        <%= (order.table&.table_number || "?").upcase %>
      </div>
      <div>
        <p class="text-sm font-semibold text-gray-900">Table <%= order.table&.table_number %></p>
        <p class="mt-1 text-xs text-gray-500">
          <%= order.created_at&.strftime("%d %b %Y · %I:%M %p") %>
          <% if order.waiter.present? %> · served by <%= order.waiter.full_name %><% end %>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= order_status_badge(order.status) %>
      <span class="text-sm font-semibold text-gray-900"><%= number_to_currency(order.total_price, precision: 2) %></span>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-2 border-t border-gray-100 pt-4">
    <%= link_to "View order", order, class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
    <%= link_to "Edit", edit_order_path(order), class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
    <% if policy(order).destroy? %>
      <%= button_to "Delete", order, method: :delete, data: { turbo_confirm: "Delete this order for good?" },
            class: "inline-flex items-center rounded-full border border-red-200 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-100" %>
    <% end %>
  </div>
</div>
