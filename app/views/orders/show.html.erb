<% content_for :title, "Order - Table #{@order.table&.table_number}" %>
<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-5xl space-y-8">

    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Waiter Console</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Order</h1>
        <p class="mt-3 text-sm text-gray-600">
          Table <%= @order.table&.table_number %>
          <% if @order.waiter.present? %> · by <%= @order.waiter.full_name %><% end %>
          · <%= @order.created_at&.strftime("%d %b %Y · %I:%M %p") %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <%= order_status_badge(@order.status) %>
        <% if policy(@order).edit? %>
          <%= link_to "Edit order", edit_order_path(@order), class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
        <% end %>
        <% if policy(@order).index? %>
          <%= link_to "All orders", orders_path, class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <!-- Order status transition -->
    <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-400">Order status</p>
          <div class="mt-2"><%= order_status_badge(@order.status) %></div>
        </div>
        <% if policy(@order).update_status? && !@order.completed? %>
          <%= button_to "Mark completed",
                update_status_order_path(@order),
                method: :patch,
                params: { order: { status: "completed" } },
                data: { turbo_confirm: "Complete this order? The table will be freed." },
                class: "cursor-pointer inline-flex items-center rounded-full bg-green-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-green-700" %>
        <% end %>
      </div>
    </div>

    <!-- Line items -->
    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">Items</h2>
        <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]"><%= @order.order_items.size %> items</span>
      </div>

      <% if @order.order_items.any? %>
        <table class="min-w-full text-left text-sm text-gray-700">
          <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
            <tr>
              <th scope="col" class="px-6 py-4">Dish</th>
              <th scope="col" class="px-6 py-4">Variation</th>
              <th scope="col" class="px-6 py-4">Qty</th>
              <th scope="col" class="px-6 py-4 text-right">Price</th>
              <th scope="col" class="px-6 py-4">Status</th>
              <th scope="col" class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @order.order_items.includes(:food, :food_variant).each do |item| %>
              <tr class="transition hover:bg-[#FAF5F1]">
                <td class="px-6 py-5">
                  <p class="font-semibold text-gray-900"><%= item.food&.name %></p>
                  <% if item.special_note.present? %>
                    <p class="mt-1 text-xs italic text-gray-500"><%= item.special_note %></p>
                  <% end %>
                </td>
                <td class="px-6 py-5 text-gray-600"><%= item.food_variant&.name || "—" %></td>
                <td class="px-6 py-5 text-gray-600"><%= item.quantity %></td>
                <td class="px-6 py-5 text-right font-medium text-gray-900"><%= number_to_currency(item.unit_price, precision: 2) %></td>
                <td class="px-6 py-5"><%= order_item_status_badge(item.status) %></td>
                <td class="px-6 py-5">
                  <div class="flex flex-wrap justify-end gap-2">
                    <% order_item_next_statuses(item.status).each do |next_status| %>
                      <%= button_to next_status.to_s.humanize,
                            update_status_order_item_path(item),
                            method: :patch,
                            params: { order_item: { status: next_status } },
                            class: "cursor-pointer inline-flex rounded-full px-3 py-2 text-xs font-semibold #{next_status == :cancelled ? 'border border-red-200 bg-red-50 text-red-700 hover:bg-red-100' : 'bg-[#8A1C2B] text-white hover:bg-[#6d1420]'}" %>
                    <% end %>
                    <% if policy(item).destroy? %>
                      <%= button_to "×", item, method: :delete, data: { turbo_confirm: "Remove this item?" },
                            class: "cursor-pointer inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-gray-400 hover:bg-gray-100" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-12 text-center text-sm text-gray-500">Nothing ordered yet.</p>
      <% end %>
    </div>

    <!-- Totals -->
    <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex justify-between text-sm text-gray-600">
        <span>Table charge (<%= @order.table&.table_type&.type&.presence || "table" %>)</span>
        <span><%= number_to_currency(@order.table_price, precision: 2) %></span>
      </div>
      <div class="mt-2 flex justify-between border-t border-gray-100 pt-4 font-serif text-2xl font-semibold text-gray-900">
        <span>Total</span>
        <span><%= number_to_currency(@order.total_price, precision: 2) %></span>
      </div>
    </div>

    <!-- Add another dish -->
    <% if policy(@order).update? && !@order.completed? %>
      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 font-serif text-2xl font-semibold text-gray-900">Add another item</h2>
        <%= render "orders/add_item_form", order: @order %>
      </div>
    <% end %>
  </div>
</div>
