<%= form_with(model: order, class: "contents",
      data: { controller: "order-form", order_form_variants: h(@variants_by_food.to_json) }) do |form| %>

  <% if order.errors.any? %>
    <div class="mb-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
      <h2 class="mb-1 font-semibold"><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>
      <ul class="list-disc pl-5">
        <% order.errors.full_messages.uniq.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <%= form.label :table_id, "Table", class: "mb-1 block text-sm font-semibold text-gray-700" %>
      <%= form.collection_select :table_id, @tables, :id, :table_number,
            { prompt: "Select a table" },
            class: "w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#8A1C2B]" %>
    </div>

    <div>
      <%= form.label :status, "Order status", class: "mb-1 block text-sm font-semibold text-gray-700" %>
      <%= form.select :status,
            Order.statuses.keys.map { |key| [key.humanize, key] },
            { selected: order.status.present? ? order.status : "inserve" },
            class: "w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#8A1C2B]" %>
    </div>
  </div>

  <div class="mt-8">
    <div class="mb-3 flex items-center justify-between">
      <h3 class="font-serif text-2xl font-semibold text-gray-900">Food &amp; Drinks</h3>
      <span class="text-xs text-gray-500">Pick a dish, then a variation only if it has one.</span>
    </div>

    <div data-order-form-target="items" class="space-y-3">
      <% if order.order_items.any? %>
        <%= form.fields_for :order_items do |ff| %>
          <%= render "orders/item_row", prefix: "order[order_items_attributes][#{ff.index}]", item: ff.object %>
        <% end %>
      <% end %>
    </div>

    <button type="button" data-action="click->order-form#addItem"
            class="mt-4 inline-flex items-center gap-2 rounded-md border border-[#8A1C2B] bg-white px-4 py-2 text-sm font-semibold text-[#8A1C2B] transition hover:bg-[#8A1C2B] hover:text-white">
      + Add dish
    </button>
  </div>

  <template data-order-form-target="template">
    <%= render "orders/item_row", prefix: "order[order_items_attributes][__INDEX__]", item: nil %>
  </template>

  <div class="mt-8 flex items-center gap-3">
    <%= form.submit "Place order", class: "rounded-md bg-[#8A1C2B] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#6d1420]" %>
    <%= link_to "Cancel", order.persisted? ? order : orders_path, class: "text-sm font-semibold text-gray-500 hover:text-[#8A1C2B]" %>
  </div>
<% end %>
