<% content_for :title, "New order" %>
<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-4xl space-y-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Waiter Console</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Place an order</h1>
      <p class="mt-4 text-sm text-gray-600">Take a customer's order — pick the dishes and their variations, then send it to the kitchen.</p>
    </div>

    <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <%= render "form", order: @order %>
    </div>
  </div>
</div>
