<%# Link showing page number.
  - available local variables
    page:          a page object for "this" page
    url:           url to this page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<% if page.current? %>
  <span aria-current="page" class="inline-flex h-10 min-w-10 items-center justify-center rounded-full bg-[#8A1C2B] px-3 text-sm font-semibold text-white shadow-sm">
    <%= page %>
  </span>
<% else %>
  <%= link_to page, url,
      remote: remote,
      rel: page.rel,
      class: "inline-flex h-10 min-w-10 items-center justify-center rounded-full border border-gray-200 bg-white px-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-[#8A1C2B]/40 hover:bg-[#8A1C2B]/10 hover:text-[#8A1C2B]" %>
<% end %>
