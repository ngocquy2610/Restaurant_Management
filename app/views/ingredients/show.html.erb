<% content_for :title, @ingredient.name %>

<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    <%= render "layouts/inventory_sidebar" %>
    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1000px]">

        <%= render "layouts/flash" %>

        <%= link_to "Back to ingredients", ingredients_path, class: "text-sm font-semibold text-[#7b1f2a] hover:underline" %>

        <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
          <div>
            <h2 class="font-serif text-[2.6rem] leading-none tracking-[-0.04em]"><%= @ingredient.name %></h2>
            <p class="mt-2 text-[1.05rem] text-[#7a5a56]">
              <%= @ingredient.category.humanize %> · measured in <%= @ingredient.unit %>
              <% unless @ingredient.active? %> · <span class="font-semibold text-[#8f1f2a]">deactivated</span><% end %>
            </p>
          </div>
          <%= ingredient_status_badge(@ingredient.status) %>
        </div>

        <dl class="mt-6 grid grid-cols-1 gap-4 rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm sm:grid-cols-3">
          <div>
            <dt class="text-sm uppercase tracking-wide text-[#7a5a56]">Current stock</dt>
            <dd class="mt-1 text-2xl font-semibold"><%= inventory_quantity(@ingredient.current_quantity, @ingredient.unit) %></dd>
          </div>
          <div>
            <dt class="text-sm uppercase tracking-wide text-[#7a5a56]">Low stock threshold</dt>
            <dd class="mt-1 text-2xl font-semibold"><%= inventory_quantity(@ingredient.low_stock_threshold, @ingredient.unit) %></dd>
          </div>
          <div>
            <dt class="text-sm uppercase tracking-wide text-[#7a5a56]">Unit cost</dt>
            <dd class="mt-1 text-2xl font-semibold">$<%= number_with_precision(@ingredient.unit_cost, precision: 2) %></dd>
          </div>
        </dl>

        <div class="mt-4 flex flex-wrap gap-3">
          <% if policy(StockTransaction).create? %>
            <%= link_to "Adjust stock", new_inventory_stock_adjustment_path(ingredient_id: @ingredient.id),
                  class: "rounded-md bg-[#7b1f2a] px-5 py-3 font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
            <%= link_to "Restock",
                  @open_restock_task ? inventory_restock_task_path(@open_restock_task) : inventory_restock_tasks_path,
                  class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
          <% end %>
          <%= link_to "Full history", inventory_stock_transactions_path(ingredient_id: @ingredient.id),
                class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
          <% if policy(@ingredient).edit? %>
            <%= link_to "Edit", edit_ingredient_path(@ingredient),
                  class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
          <% end %>
          <% if policy(@ingredient).deactivate? && @ingredient.active? %>
            <%= button_to "Deactivate", deactivate_ingredient_path(@ingredient), method: :patch,
                  data: { turbo_confirm: "Deactivate #{@ingredient.name}?" },
                  class: "cursor-pointer rounded-md bg-[#8f1f2a] px-5 py-3 font-semibold text-white hover:bg-[#7a1a23]" %>
          <% elsif policy(@ingredient).reactivate? && !@ingredient.active? %>
            <%= button_to "Reactivate", reactivate_ingredient_path(@ingredient), method: :patch,
                  class: "cursor-pointer rounded-md bg-[#25512d] px-5 py-3 font-semibold text-white hover:bg-[#1d3f23]" %>
          <% end %>
        </div>

        <h3 class="mt-10 font-serif text-[1.6rem] font-semibold">Recent transactions</h3>
        <div class="mt-4 overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
          <table class="w-full text-left text-sm">
            <thead class="bg-[#f1e3df] text-[0.72rem] uppercase tracking-[0.14em] text-[#9b6a63]">
              <tr>
                <th class="px-5 py-3">Time</th>
                <th class="px-5 py-3">Type</th>
                <th class="px-5 py-3">Qty</th>
                <th class="px-5 py-3">Before / After</th>
                <th class="px-5 py-3">By</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e4d6d2]">
              <% @recent_transactions.each do |tx| %>
                <tr>
                  <td class="px-5 py-3 text-[#7a5a56]"><%= inventory_time(tx.created_at) %></td>
                  <td class="px-5 py-3"><%= stock_transaction_type_badge(tx.transaction_type) %></td>
                  <td class="px-5 py-3 <%= tx.signed_quantity.negative? ? 'text-[#8f1f2a]' : 'text-[#25512d]' %>">
                    <%= inventory_quantity(tx.signed_quantity, @ingredient.unit) %>
                  </td>
                  <td class="px-5 py-3 text-[#7a5a56]"><%= inventory_quantity(tx.quantity_before) %> / <%= inventory_quantity(tx.quantity_after) %></td>
                  <td class="px-5 py-3 text-[#7a5a56]"><%= tx.user&.full_name || "System" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @recent_transactions.empty? %>
            <p class="px-5 py-6 text-sm text-[#7a5a56]">No transactions yet.</p>
          <% end %>
        </div>

      </div>
    </main>
  </div>
</div>

