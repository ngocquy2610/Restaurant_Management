<% content_for :title, "Ingredients" %>

<div class="min-h-screen bg-[#f4e6e2] px-4 pb-10 pt-28 text-[#2f1f1d] sm:px-6 lg:px-8">
  <div class="admin-flex flex flex-col gap-4 md:flex-row md:gap-6">
    <%= render "layouts/menu_sidebar" %>

    <main class="w-full min-w-0 max-w-full flex-1 bg-[#f6efee] px-4 py-5 sm:px-8 sm:py-6">
      <%= render "layouts/admin_mobile_nav" %>
      <div class="mx-auto max-w-[1260px]">

        <% if notice.present? %>
          <p class="mb-5 inline-block rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-600" id="notice"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="mb-5 inline-block rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
        <% end %>

        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="font-serif text-2xl leading-none tracking-[-0.06em] sm:text-4xl lg:text-5xl text-[#2f1f1d]">Ingredients</h2>
            <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Search, filter and manage the raw materials used across your menu.</p>
          </div>
          <% if policy(Ingredient).new? %>
            <%= link_to "New ingredient", new_ingredient_path, class: "w-full rounded-md bg-[#7b1f2a] px-5 py-3 text-center font-semibold text-white shadow-sm hover:bg-[#661a23] sm:w-auto" %>
          <% end %>
        </div>

        <%= form_with url: ingredients_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |f| %>
          <div>
            <%= f.label :q, "Search", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.text_field :q, value: params[:q], placeholder: "Ingredient name…",
                  class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-3 py-2 text-sm text-[#2c1c1a]" %>
          </div>
          <div>
            <%= f.label :category, class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.select :category,
                  options_for_select(Ingredient::CATEGORIES.map { |c| [c.humanize, c] }, params[:category]),
                  { include_blank: "All categories" },
                  class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-3 py-2 text-sm text-[#2c1c1a]" %>
          </div>
          <div>
            <%= f.label :status, class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-[#7c5d58]" %>
            <%= f.select :status,
                  options_for_select([["OK", "in_stock"], ["Low", "low_stock"], ["Out", "out_of_stock"]], params[:status]),
                  { include_blank: "All statuses" },
                  class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-3 py-2 text-sm text-[#2c1c1a]" %>
          </div>
          <%= f.submit "Filter", class: "cursor-pointer rounded-md bg-[#7b1f2a] px-4 py-2 text-sm font-semibold text-white hover:bg-[#661a23]" %>
          <%= link_to "Clear", ingredients_path, class: "pb-2 text-sm font-semibold text-[#7b1f2a] hover:underline" %>
        <% end %>

        <div class="mb-4 flex gap-4 text-sm font-semibold">
          <%= link_to "Active", ingredients_path(request.query_parameters.except("inactive", "page")),
                class: @show_inactive ? "text-[#5c4543] hover:underline" : "text-[#7b1f2a] underline" %>
          <%= link_to "Deactivated", ingredients_path(request.query_parameters.except("page").merge("inactive" => "1")),
                class: @show_inactive ? "text-[#7b1f2a] underline" : "text-[#5c4543] hover:underline" %>
        </div>

        <div class="overflow-x-auto rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
          <table class="w-full text-left text-sm">
            <thead class="bg-[#f1e3df] text-[0.72rem] uppercase tracking-[0.14em] text-[#9b6a63]">
              <tr>
                <th class="px-3 sm:px-5 py-3">Name</th>
                <th class="px-3 sm:px-5 py-3">Category</th>
                <th class="px-3 sm:px-5 py-3">Unit cost</th>
                <th class="px-3 sm:px-5 py-3">Stock / Threshold</th>
                <th class="px-3 sm:px-5 py-3">Status</th>
                <th class="px-3 sm:px-5 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e4d6d2]">
              <% @ingredients.each do |ingredient| %>
                <tr id="<%= dom_id ingredient %>">
                  <td class="px-3 sm:px-5 py-3 font-semibold"><%= link_to ingredient.name, ingredient_path(ingredient), class: "hover:underline" %></td>
                  <td class="px-3 sm:px-5 py-3 text-[#7a5a56]"><%= ingredient.category.humanize %></td>
                  <td class="px-3 sm:px-5 py-3">$<%= number_with_precision(ingredient.unit_cost, precision: 2) %></td>
                  <td class="px-3 sm:px-5 py-3">
                    <%= inventory_quantity(ingredient.current_quantity, ingredient.unit) %>
                    <span class="text-[#7a5a56]">/ <%= inventory_quantity(ingredient.low_stock_threshold, ingredient.unit) %></span>
                  </td>
                  <td class="px-3 sm:px-5 py-3"><%= ingredient_status_badge(ingredient.status) %></td>
                  <td class="px-3 sm:px-5 py-3 text-right whitespace-nowrap">
                    <%= link_to "View", ingredient_path(ingredient), class: "font-semibold text-[#7b1f2a] hover:underline" %>
                    <% if policy(ingredient).edit? %>
                      <%= link_to "Edit", edit_ingredient_path(ingredient), class: "ml-3 font-semibold text-[#7b1f2a] hover:underline" %>
                    <% end %>
                    <% if policy(ingredient).deactivate? && ingredient.active? %>
                      <%= button_to "Deactivate", deactivate_ingredient_path(ingredient), method: :patch,
                            form: { class: "inline" },
                            data: { turbo_confirm: "Deactivate #{ingredient.name}?" },
                            class: "ml-3 cursor-pointer font-semibold text-[#8f1f2a] hover:underline" %>
                    <% end %>
                    <% if policy(ingredient).reactivate? && !ingredient.active? %>
                      <%= button_to "Reactivate", reactivate_ingredient_path(ingredient), method: :patch,
                            form: { class: "inline" },
                            class: "ml-3 cursor-pointer font-semibold text-[#25512d] hover:underline" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @ingredients.empty? %>
            <p class="px-5 py-6 text-sm text-[#7a5a56]">No ingredients match your filters.</p>
          <% end %>
        </div>

        <%= paginate @ingredients %>

      </div>
    </main>
  </div>
</div>
