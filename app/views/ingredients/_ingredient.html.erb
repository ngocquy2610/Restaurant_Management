<% stock = ingredient.current_stock || 0 %>
<% threshold = ingredient.low_stock_threshold || 0 %>
<% low = stock <= threshold %>

<article id="<%= dom_id ingredient %>" class="flex flex-col overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-[1.6rem] font-semibold leading-tight tracking-tight text-[#2f1f1d]"><%= ingredient.name %></h3>
    <span class="whitespace-nowrap rounded-full bg-[#f0e7e5] px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-[#5d4b49]"><%= ingredient.unit %></span>
  </div>

  <div class="mt-5 space-y-2 text-[0.95rem] text-[#7a5a56]">
    <div class="flex items-center justify-between">
      <span>Unit cost</span>
      <span class="font-semibold text-[#2f1f1d]">$<%= number_to_currency(ingredient.unit_cost || 0, precision: 2, unit: "") %></span>
    </div>
    <div class="flex items-center justify-between">
      <span>Current stock</span>
      <span class="font-semibold text-[#2f1f1d]"><%= stock %> <%= ingredient.unit %></span>
    </div>
  </div>

  <div class="mt-3">
    <% if low %>
      <span class="inline-flex items-center rounded-full bg-[#8f1f2a] px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-white">
        Low stock
      </span>
    <% else %>
      <span class="inline-flex items-center rounded-full bg-[#25512d]/90 px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-white">
        In stock
      </span>
    <% end %>
  </div>

  <div class="mt-6 flex items-center gap-2 border-t border-[#e4d6d2] pt-5">
    <%= link_to "Edit", edit_ingredient_path(ingredient), class: "flex h-10 flex-1 items-center justify-center rounded-md border border-[#d8c1bc] bg-[#f8efee] text-sm font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
    <%= button_to "Delete", ingredient, method: :delete, data: { turbo_confirm: "Delete this ingredient? This cannot be undone." }, class: "flex h-10 flex-1 cursor-pointer items-center justify-center rounded-md bg-[#8f1f2a] p-2 text-sm font-semibold text-white hover:bg-[#7a1a23]" %>
  </div>
</article>
