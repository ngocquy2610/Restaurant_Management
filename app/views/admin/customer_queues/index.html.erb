<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 px-4 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">

    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Customer Queue</h1>
        <p class="mt-4 text-sm text-gray-600">Walk-in guests waiting for a table. They are seated automatically in order the moment a table frees up, or manually below.</p>
      </div>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <!-- Add walk-in -->
    <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="font-serif text-xl font-semibold text-gray-900">Add a walk-in guest</h2>
      <p class="mt-1 text-sm text-gray-600">Shown when there is no free table — they join the waiting queue below.</p>

      <%= form_with(model: @customer_queue, url: admin_customer_queues_path, class: "mt-5 flex flex-wrap items-end gap-3") do |form| %>
        <div>
          <%= form.label :guest_name, "Guest name", class: "mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-gray-500" %>
          <%= form.text_field :guest_name, placeholder: "e.g. John Doe", class: "rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
        </div>
        <div>
          <%= form.label :guest_phone, "Phone", class: "mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-gray-500" %>
          <%= form.telephone_field :guest_phone, placeholder: "e.g. 0812345678", class: "rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
        </div>
        <div>
          <%= form.label :note, "Note", class: "mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-gray-500" %>
          <%= form.text_field :note, placeholder: "Optional", class: "rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
        </div>
        <%= form.submit "Add to queue", class: "cursor-pointer inline-flex items-center rounded-full bg-[#8A1C2B] px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
      <% end %>
<!-- Waiting list -->
    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">Waiting</h2>
        <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]"><%= @queues.size %> waiting</span>
      </div>

      <% if @queues.any? %>
        <table class="min-w-full text-left text-sm text-gray-700">
          <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
            <tr>
              <th scope="col" class="px-6 py-4">Guest</th>
              <th scope="col" class="px-6 py-4">Phone</th>
              <th scope="col" class="px-6 py-4">Note</th>
              <th scope="col" class="px-6 py-4">Joined</th>
              <th scope="col" class="px-6 py-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @queues.each do |queue| %>
              <tr class="transition hover:bg-[#FAF5F1]">
                <td class="px-6 py-5">
                  <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 font-serif text-base font-bold text-[#8A1C2B]">
                      <%= queue.guest_name.to_s[0, 2].upcase %>
                    </div>
                    <p class="text-sm font-semibold text-gray-900"><%= queue.guest_name %></p>
                  </div>
                </td>
                <td class="px-6 py-5 text-sm text-gray-600"><%= queue.guest_phone %></td>
                <td class="px-6 py-5 text-sm text-gray-600"><%= queue.note %></td>
                <td class="px-6 py-5 text-sm text-gray-600"><%= queue.created_at.strftime("%I:%M %p") %></td>
                <td class="px-6 py-5">
                  <div class="flex flex-wrap justify-end gap-2">
                    <% if @available_tables.any? %>
                      <%= form_with url: seat_admin_customer_queue_path(queue), method: :patch, class: "flex items-center gap-2" do %>
                        <%= select_tag :table_id,
                              options_from_collection_for_select(@available_tables, :id, :table_number, { include_blank: "Seat at…" }),
                              class: "rounded-md border border-gray-200 bg-white px-2 py-1.5 text-xs text-gray-700" %>
                        <%= submit_tag "Seat", class: "cursor-pointer inline-flex rounded-full bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-teal-700" %>
                      <% end %>
                    <% end %>
                    <%= button_to "Cancel", cancel_admin_customer_queue_path(queue),
                          method: :patch,
                          class: "cursor-pointer inline-flex rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100",
                          data: { turbo_confirm: "Remove #{queue.guest_name} from the queue?" } %>
                    
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-10 text-center text-sm text-gray-500">The queue is empty — no walk-in guests waiting right now.</p>
      <% end %>
    </div>
  </div>
</div>
    </div>