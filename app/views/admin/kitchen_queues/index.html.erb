<% content_for :title, "Kitchen Queue" %>
<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 px-4 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">

    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Kitchen Console</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Order Queue</h1>
        <p class="mt-4 text-sm text-gray-600">Everything the kitchen needs to cook — advance each dish through its stages.</p>
      </div>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <!-- Status summary -->
    <% kitchen_statuses = %w[pending accepted preparing] %>
    <div class="flex flex-wrap gap-3">
      <% kitchen_statuses.each do |status_name| %>
        <% meta = OrdersHelper::ORDER_ITEM_STATUS_META.fetch(status_name) %>
        <% count = @items.count { |item| item.status.to_s == status_name } %>
        <span class="inline-flex items-center gap-2 rounded-full <%= meta[:chip] %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= meta[:text] %>">
          <span class="h-2 w-2 rounded-full <%= meta[:dot] %>"></span>
          <%= meta[:label] %> · <%= count %>
        </span>
      <% end %>
    </div>

    <!-- Kanban board -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <% kitchen_statuses.each do |status_name| %>
        <% column_items = @items.select { |item| item.status.to_s == status_name } %>
        <div class="flex flex-col rounded-[2rem] border border-gray-200 bg-[#F7F2EE] shadow-sm">
          <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
            <h2 class="font-serif text-xl font-semibold text-gray-900 capitalize"><%= status_name %></h2>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#8A1C2B]/10 text-sm font-semibold text-[#8A1C2B]"><%= column_items.size %></span>
          </div>

          <div class="flex max-h-[590px] flex-col gap-4 overflow-y-auto overscroll-contain px-4 py-4 pr-3">
            <% if column_items.any? %>
              <% column_items.each do |item| %>
                <div id="<%= dom_id(item) %>" class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
                  <div class="flex items-center justify-between">
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#8A1C2B]/10 font-serif text-sm font-bold text-[#8A1C2B]">
                      <%= item.order&.table&.table_number || "?" %>
                    </div>
                    <span class="text-xs text-gray-500"><%= item.created_at&.strftime("%H:%M") %></span>
                  </div>

                  <p class="mt-3 font-serif text-lg font-semibold text-gray-900"><%= item.food&.name %></p>
                  <% if item.order&.preorder? && item.order&.released_to_kitchen? %>
                    <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Pre-order · Ưu tiên</span>
                  <% end %>
                  <p class="text-sm text-gray-600">
                    Table <%= item.order&.table&.table_number %> · Qty <%= item.quantity %>
                    <% if item.food_variant.present? %> · <span class="text-gray-500"><%= item.food_variant.name %></span><% end %>
                  </p>
                  <% if item.special_note.present? %>
                    <p class="mt-2 text-xs italic text-amber-700">“<%= item.special_note %>”</p>
                  <% end %>

                  <div class="mt-3 flex flex-wrap gap-2">
                    <%= link_to "Detail",
                          admin_kitchen_queue_path(item.order),
                          class: "inline-flex rounded-full border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:border-[#8A1C2B] hover:text-[#8A1C2B]" %>
                    <% order_item_next_statuses(item.status).each do |next_status| %>
                      <%= button_to next_status.to_s.humanize,
                            admin_kitchen_queue_update_item_status_path(item.order, item),
                            method: :patch,
                            params: { order_item: { status: next_status } },
                            class: "cursor-pointer inline-flex rounded-full px-3 py-1.5 text-xs font-semibold #{next_status == :cancelled ? 'border border-red-200 bg-red-50 text-red-700 hover:bg-red-100' : 'bg-[#8A1C2B] text-white hover:bg-[#6d1420]'}" %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="rounded-xl border border-dashed border-[#d7b9b2] bg-white px-4 py-6 text-center text-sm text-gray-500">Nothing here.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>