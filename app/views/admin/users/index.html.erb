<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 px-4 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Staff Directory</h1>
        <p class="mt-4 text-sm text-gray-600">Manage and view all current employees across departments.</p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <label class="relative block w-full sm:w-auto">
          <span class="sr-only">Search staff</span>
          <input
            type="search"
            placeholder="Search staff…"
            class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20"
          />
        </label>
        <button type="button" class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50">
          All Roles
        </button>
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm text-gray-700">
          <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
            <tr>
              <th scope="col" class="px-6 py-4">User</th>
              <th scope="col" class="px-6 py-4">Role</th>
              <th scope="col" class="px-6 py-4">Department</th>
              <th scope="col" class="px-6 py-4">Contact</th>
              <th scope="col" class="px-6 py-4">Status</th>
              <th scope="col" class="px-6 py-4">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% department_map = {
              admin: "Management",
              inventory_manager: "Inventory",
              kitchen_staff: "Kitchen",
              receptionist: "Front of House",
              waiter: "Front of House",
              customer: "Guest"
            } %>
            <% @users.each do |user| %>
              <% initials = user.full_name.to_s.split.map { |part| part[0] }.join.upcase %>
              <% role_key = user.role&.to_sym %>
              <% department = department_map[role_key] || user.role.to_s.humanize %>
              <tr class="transition hover:bg-[#FAF5F1]">
                <td class="px-6 py-5">
                  <div class="flex items-center gap-4">
                    <% if user.avatar.attached? %>
                      <%= image_tag user.avatar,
                            class: "h-12 w-12 rounded-2xl border border-gray-200 object-cover text-sm font-semibold text-[#8A1C2B]",
                            alt: "#{user.full_name}'s avatar" %>
                    <% else %>
                      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-sm font-semibold text-[#8A1C2B]">
                        <%= initials.presence || "?" %>
                      </div>
                    <% end %>
                    <div>
                      <p class="text-sm font-semibold text-gray-900"><%= user.full_name %></p>
                      <p class="mt-1 text-xs text-gray-500"><%= user.email %></p>
                      <% if user.member_tier.present? %>
                        <p class="mt-1 text-xs text-gray-400"><%= user.member_tier.name %> member</p>
                      <% end %>
                    </div>
                  </div>
                </td>

                <td class="px-6 py-5">
                  <%= form_with url: user_path(user), method: :patch, class: "inline-block" do %>
                    <%= hidden_field_tag :back_to_directory, "true" %>
                    <select name="user[role]" onchange="this.form.submit()"
                            class="w-40 cursor-pointer rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-800 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20"
                            title="Change role for <%= user.full_name %>">
                      <% User.roles.keys.each do |key| %>
                        <option value="<%= key %>" <%= "selected" if user.role == key %>><%= key.titleize %></option>
                      <% end %>
                    </select>
                  <% end %>
                </td>

                <td class="px-6 py-5">
                  <p class="text-sm text-gray-600"><%= department %></p>
                </td>

                <td class="px-6 py-5">
                  <p class="text-sm text-gray-600"><%= user.phone %></p>
                  <p class="mt-1 text-xs text-gray-400"><%= user.location.presence || "—" %></p>
                </td>

                <td class="px-6 py-5">
                  <% if user.status %>
                    <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]">
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-gray-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-gray-600">
                      Inactive
                    </span>
                  <% end %>
                  <% if user == current_user %>
                    <p class="mt-1 text-[11px] text-gray-400">(you)</p>
                  <% end %>
                </td>

                <td class="px-6 py-5">
                  <div class="flex items-center gap-2">
                    <%= link_to "View", user_path(user), class: "inline-flex rounded-full border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-700 transition hover:bg-gray-50" %>
                    <%= link_to "Edit", edit_user_path(user), class: "inline-flex rounded-full bg-[#8A1C2B]/10 px-3 py-2 text-xs font-semibold text-[#8A1C2B] transition hover:bg-[#8A1C2B]/20" %>
                    <% if policy(user).destroy? %>
                      <%= button_to "Delete", user_path(user), method: :delete,
                            form: { data: { turbo_confirm: "Are you sure you want to permanently delete #{user.full_name}? This action cannot be undone." } },
                            class: "inline-flex rounded-full border border-red-200 bg-white px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-50" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>