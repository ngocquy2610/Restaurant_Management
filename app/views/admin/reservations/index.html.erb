<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 px-4 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">

    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Reservations</h1>
        <p class="mt-4 text-sm text-gray-600">Review and confirm every booking. Approving keeps the table reserved; rejecting frees it; checking in marks it occupied.</p>
      </div>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">All Reservations</h2>
        <span class="inline-flex rounded-full bg-[#E9CFC7] px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#8A1C2B]"><%= @reservations.size %> bookings</span>
      </div>

      <% if @reservations.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm text-gray-700">
            <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
              <tr>
                <th scope="col" class="px-6 py-4">Guest</th>
                <th scope="col" class="px-6 py-4">Phone</th>
                <th scope="col" class="px-6 py-4">Table</th>
                <th scope="col" class="px-6 py-4">Date &amp; time</th>
                <th scope="col" class="px-6 py-4">Status</th>
                <th scope="col" class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @reservations.each do |reservation| %>
                <tr class="transition hover:bg-[#FAF5F1]">
                  <td class="px-6 py-5">
                    <div class="flex items-center gap-4">
                      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 font-serif text-base font-bold text-[#8A1C2B]">
                        <%= reservation.guest_name.to_s[0, 2].upcase %>
                      </div>
                      <div>
                        <p class="text-sm font-semibold text-gray-900"><%= reservation.guest_name %></p>
                        <% if reservation.user.present? %>
                          <p class="mt-1 text-xs text-gray-500"><%= reservation.user.full_name %></p>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.guest_phone %></td>
                  <td class="px-6 py-5 text-sm text-gray-600">Table <%= reservation.table&.table_number %></td>
                  <td class="px-6 py-5 text-sm text-gray-600">
                    <%= reservation.reservation_date %> · <%= reservation.reservation_time&.strftime("%I:%M %p") %>
                  </td>
                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full <%= reservation_status_chip_class(reservation.status) %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= reservation_status_meta(reservation.status)[:text] %>">
                      <span class="h-2 w-2 rounded-full <%= reservation_status_dot_class(reservation.status) %>"></span>
                      <%= reservation_status_label(reservation.status) %>
                    </span>
                  </td>
                  <td class="px-6 py-5">
                    <div class="flex flex-wrap justify-end gap-2">
                      <% reservation_actions(reservation).each do |action| %>
                        <%= button_to action[:label],
                              update_status_admin_reservation_path(reservation),
                              method: :patch,
                              params: { reservation: { status: action[:status] } },
                              class: "cursor-pointer inline-flex rounded-full px-3 py-2 text-xs font-semibold #{action[:classes]}",
                              data: { turbo_confirm: action[:confirm] } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-6 py-10 text-center text-sm text-gray-500">No reservations have been made yet.</p>
      <% end %>
    </div>
  </div>
</div>