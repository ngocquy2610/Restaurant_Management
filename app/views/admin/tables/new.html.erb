<% content_for :title, "New table" %>

<div class="min-h-screen bg-[#FBF0EC] py-10 pt-28">
  <div class="w-full">
    <div class="flex gap-6">
      <%= render "layouts/admin_sidebar" %>

      <main class="flex-1 space-y-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/70">Floor management</p>
            <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">New table</h1>
            <p class="mt-3 text-sm text-gray-600">Add a table to your restaurant and place it on the floor map.</p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "Back to dashboard", admin_dashboards_path,
                class: "inline-flex shrink-0 items-center rounded-full bg-[#8A1C2B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
            <%= link_to "← Back to layout", tables_path,
                class: "inline-flex shrink-0 items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>
        </div>

        <%= render "admin/tables/form" %>
      </main>
    </div>
  </div>
</div>

