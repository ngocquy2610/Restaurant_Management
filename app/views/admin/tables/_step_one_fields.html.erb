<div class="mx-auto w-full max-w-3xl space-y-6" data-table-wizard-target="stepOne">
  <div data-table-wizard-target="errorAlert"
       class="mb-4 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm font-medium text-red-600"
       role="alert"></div>

  <!-- Details card -->
  <div class="rounded-[1.75rem] border border-[#8A1C2B]/10 bg-white/80 p-6 shadow-sm sm:p-8">
    <div class="mb-8">
      <h2 class="font-serif text-2xl font-semibold text-gray-900">Table details</h2>
      <p class="mt-1 text-sm text-gray-500">Tell us about the table — you'll position it on the floor map next.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <!-- Area -->
      <div>
        <%= f.label :area_id, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🗺️</span>
          Area
        <% end %>
        <%= f.collection_select :area_id, @areas, :id, :name,
              { prompt: "Select an area" },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true,
              data: { table_wizard_target: "areaSelect", action: "change->table-wizard#recomputeTableNumber" } %>
      </div>

      <!-- Table type -->
      <div>
        <%= f.label :table_type_id, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🪑</span>
          Table type
        <% end %>
        <%= f.collection_select :table_type_id, @table_types, :id, :type,
              { prompt: "Select a table type" },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true,
              data: { table_wizard_target: "tableTypeSelect", action: "change->table-wizard#recomputeTableNumber" } %>
      </div>

      <!-- Table number -->
      <div>
        <%= f.label :table_number, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🔢</span>
          Table number
        <% end %>
        <%= f.text_field :table_number,
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20 placeholder:text-gray-400",
              placeholder: "Auto-generated",
              readonly: @table.new_record?,
              data: { table_wizard_target: "tableNumberField" } %>
        <% if @table.new_record? %>
          <p class="mt-1.5 text-xs text-gray-500" data-table-wizard-target="tableNumberHint">Auto-filled from area + table type after you select them.</p>
        <% end %>
      </div>

      <!-- Capacity -->
      <div>
        <%= f.label :capacity, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">👥</span>
          Capacity
        <% end %>
        <%= f.select :capacity,
              allowed_capacity_options,
              { prompt: "Select capacity", selected: @table.capacity },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true,
              data: { action: "change->table-wizard#capacityChanged" } %>
        <p class="mt-1.5 text-xs text-gray-500">Square seats 2–4, round seats 4–6, rectangle seats 6–10.</p>
      </div>

      <!-- Status -->
      <div>
        <%= f.label :status, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🟢</span>
          Status
        <% end %>
        <%= f.select :status,
              Table.statuses.keys.map { |key| [key.to_s.humanize, key] },
              { selected: (@table.status || "available") },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true %>
      </div>

      <!-- Shape -->
      <div>
        <%= f.label :shape, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">⬜</span>
          Shape
        <% end %>
        <%= f.select :shape,
              Table.shapes.keys.map { |key| [key.to_s.humanize, key] },
              { selected: (@table.shape || "square") },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true,
              data: { action: "change->table-wizard#shapeChanged" } %>
        <p class="mt-1.5 text-xs text-gray-500">Options adapt to the capacity you choose.</p>
      </div>
    </div>
  </div>

  <!-- Live appearance preview -->
  <div class="rounded-[1.75rem] border border-[#8A1C2B]/10 bg-white/60 px-6 py-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#8A1C2B]/70">Appearance preview</p>
        <p class="mt-1 text-sm text-gray-500">This is how your table will look on the floor map.</p>
      </div>
      <div class="flex h-28 w-28 items-center justify-center rounded-2xl bg-[#FBF0EC]"
           data-table-wizard-target="shapePreview"></div>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex justify-end">
    <button type="button"
            data-action="table-wizard#goToStepTwo"
            class="inline-flex items-center gap-2 rounded-full bg-[#8A1C2B] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]">
      Continue to floor map
      <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

