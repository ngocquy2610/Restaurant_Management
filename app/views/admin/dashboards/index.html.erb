<div class="relative"><%= render "layouts/header" %></div>
<div class="min-h-screen bg-[#FBF0EC] py-10 px-4 pt-28">
  <div class="mx-auto max-w-7xl space-y-8">

    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
        <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Restaurant Overview</h1>
        <p class="mt-4 text-sm text-gray-600">A live snapshot of your restaurant's performance across the floor, kitchen, and business.</p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <%= link_to "Tables", tables_path, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
        <%= link_to "Staff Directory", admin_users_path, class: "inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
        <button type="button" class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50">
          This Week
        </button>
      </div>
    </div>

    <!-- Stat cards -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Total Revenue</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">💰</span>
        </div>
        <p class="mt-4 font-serif text-3xl font-semibold text-gray-900">$48,250</p>
        <p class="mt-2 text-xs font-semibold text-green-600">▲ 12.4% vs last week</p>
      </div>

      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Active Reservations</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">📅</span>
        </div>
        <p class="mt-4 font-serif text-3xl font-semibold text-gray-900">86</p>
        <p class="mt-2 text-xs font-semibold text-gray-400">Tonight's service</p>
      </div>

      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Tables Occupied</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">🍽️</span>
        </div>
        <p class="mt-4 font-serif text-3xl font-semibold text-gray-900">27 / 40</p>
        <p class="mt-2 text-xs font-semibold text-amber-600">68% capacity</p>
      </div>

      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Staff On Duty</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">👥</span>
        </div>
        <p class="mt-4 font-serif text-3xl font-semibold text-gray-900">14</p>
        <p class="mt-2 text-xs font-semibold text-gray-400">across 5 departments</p>
      </div>
    </div>

    <!-- Quick management -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">Quick Management</h2>
        <a href="#" class="text-sm font-semibold text-[#8A1C2B] hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <%= link_to tables_path, class: "group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]" do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Tables</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">🍽️</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">Manage the dining floor plan and tables.</p>
        <% end %>

        <%= link_to admin_users_path, class: "group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]" do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Employees</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">👥</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">Manage staff across departments.</p>
        <% end %>

        <%= link_to admin_reservations_path, class: "group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]" do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Reservations</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">📅</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">View and manage bookings.</p>
        <% end %>

        <%= link_to categories_path, class: "group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]" do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Menu &amp; Inventory</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">📦</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">Update dishes and stock levels.</p>
        <% end %>

        <%= link_to promotions_path, class: "group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]" do %>
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Promotions</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">🏷️</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">Create and manage special offers.</p>
        <% end %>

        <a href="#" class="group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[#8A1C2B]/30 hover:bg-[#FAF5F1]">
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-gray-900">Reports</p>
            <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-lg">📊</span>
          </div>
          <p class="mt-4 text-xs text-gray-600">Analyse sales and performance.</p>
        </a>
      </div>
    </div>


    <!-- Recent reservations -->
    <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <h2 class="font-serif text-2xl font-semibold text-gray-900">Recent Reservations</h2>
        <%= link_to "View all",
            admin_reservations_path,
            class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
      </div>
      <% if @reservations.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm text-gray-700">
            <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
              <tr>
                <th scope="col" class="px-6 py-4">Guest</th>
                <th scope="col" class="px-6 py-4">Party</th>
                <th scope="col" class="px-6 py-4">Time</th>
                <th scope="col" class="px-6 py-4">Table</th>
                <th scope="col" class="px-6 py-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @reservations.each do |reservation| %>
                <tr class="transition hover:bg-[#FAF5F1]">
                  <td class="px-6 py-5">
                    <div class="flex items-center gap-4">
                      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-sm font-semibold text-[#8A1C2B]">
                        <%= reservation.guest_name.to_s[0, 2].upcase %>
                      </div>
                      <div>
                        <p class="text-sm font-semibold text-gray-900"><%= reservation.guest_name %></p>
                        <% if reservation.user.present? %>
                          <p class="mt-1 text-xs text-gray-500"><%= reservation.user.full_name %></p>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.table&.capacity %> guests</td>
                  <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.reservation_time&.strftime("%I:%M %p") %></td>
                  <td class="px-6 py-5 text-sm text-gray-600">Table <%= reservation.table&.table_number %></td>
                  <td class="px-6 py-5">
                    <span class="inline-flex items-center gap-2 rounded-full <%= reservation_status_chip_class(reservation.status) %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= reservation_status_meta(reservation.status)[:text] %>">
                      <span class="h-2 w-2 rounded-full <%= reservation_status_dot_class(reservation.status) %>"></span>
                      <%= reservation_status_label(reservation.status) %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <%= paginate @reservations %>
        </div>
      <% else %>
        <p class="px-6 py-10 text-center text-sm text-gray-500">No active reservations right now.</p>
      <% end %>
    </div>
  </div>
</div>
