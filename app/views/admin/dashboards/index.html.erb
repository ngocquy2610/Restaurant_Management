<div class="min-h-screen bg-[#FBF0EC] px-4 pb-10 pt-28 sm:px-6 lg:px-8"><div class="mx-auto w-full max-w-7xl">
  <div class="w-full">
    <div class="admin-flex flex flex-col gap-4 md:flex-row md:gap-6">
      <%= render "layouts/admin_sidebar" %>

      <main class="w-full min-w-0 max-w-full flex-1 space-y-5 sm:space-y-8">
        <%= render "layouts/admin_mobile_nav" %>
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
            <h1 class="mt-3 font-serif text-2xl font-semibold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">Restaurant Overview</h1>
            <p class="mt-4 text-sm text-gray-600">Headline business and operational KPIs across the floor, kitchen, and guest experience.</p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <%= link_to "Restaurant Performance", performance_admin_dashboards_path(from_date: @from_date, to_date: @to_date), class: "inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
            <%= link_to "Tables", tables_path, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Net Revenue</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= money(@overview[:net_revenue]) %></p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Gross Profit</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= number_to_currency(@overview[:gross_profit]) %></p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Gross Margin</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= number_with_precision(@overview[:gross_margin], precision: 1) %>%</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Occupancy</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= number_with_precision(@overview[:occupancy_rate], precision: 1) %>%</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Avg Rating</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= rating(@overview[:avg_rating]) %>/5</p>
          </div>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 sm:rounded-[2rem] sm:p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Low Stock</p>
            <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= @overview[:low_stock_count] %></p>
          </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm sm:rounded-[2rem] sm:p-6">
          <div class="flex items-center justify-between">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Operations snapshot</h2>
            <%= link_to "View full report", performance_admin_dashboards_path(from_date: @from_date, to_date: @to_date), class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>

          <div class="mt-4 grid grid-cols-1 gap-3 sm:mt-6 sm:gap-4 md:grid-cols-3">
            <div class="rounded-xl border border-gray-200 bg-[#FAF5F1] p-3 sm:rounded-[1.5rem] sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Reservations</p>
              <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= Reservation.where(created_at: @time_range).count %></p>
            </div>

            <div class="rounded-xl border border-gray-200 bg-[#FAF5F1] p-3 sm:rounded-[1.5rem] sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Orders</p>
              <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= Order.where(created_at: @time_range).count %></p>
            </div>

            <div class="rounded-xl border border-gray-200 bg-[#FAF5F1] p-3 sm:rounded-[1.5rem] sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Reviews</p>
              <p class="mt-2 break-words font-serif text-lg font-semibold text-gray-900 sm:mt-4 sm:text-3xl"><%= Review.where(created_at: @time_range).count %></p>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
          <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Recent Reservations</h2>
            <%= link_to "View all", admin_reservations_path, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>

          <% if @reservations.any? %>
            <div class="overflow-x-auto">
              <table class="min-w-full text-left text-sm text-gray-700">
                <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
                  <tr>
                    <th scope="col" class="px-4 py-3 sm:px-6 sm:py-4">Guest</th>
                    <th scope="col" class="px-4 py-3 sm:px-6 sm:py-4">Party</th>
                    <th scope="col" class="px-4 py-3 sm:px-6 sm:py-4">Time</th>
                    <th scope="col" class="px-4 py-3 sm:px-6 sm:py-4">Table</th>
                    <th scope="col" class="px-4 py-3 sm:px-6 sm:py-4">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  <% @reservations.each do |reservation| %>
                    <tr class="transition hover:bg-[#FAF5F1]">
                      <td class="px-4 py-3 sm:px-6 sm:py-5">
                        <div class="flex items-center gap-4">
                          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-sm font-semibold text-[#8A1C2B]">
                            <%= reservation.guest_name.to_s[0, 2].upcase %>
                          </div>
                          <div>
                            <p class="text-sm font-semibold text-gray-900"><%= reservation.guest_name %></p>
                            <% if reservation.user.present? %>
                              <p class="mt-1 text-xs text-gray-500"><%= reservation.user.full_name %></p>
                            <% end %>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.table&.capacity %> guests</td>
                      <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.reservation_time&.strftime("%I:%M %p") %></td>
                      <td class="px-6 py-5 text-sm text-gray-600">Table <%= reservation.table&.table_number %></td>
                      <td class="px-4 py-3 sm:px-6 sm:py-5">
                        <span class="inline-flex items-center gap-2 rounded-full <%= reservation_status_chip_class(reservation.status) %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= reservation_status_meta(reservation.status)[:text] %>">
                          <span class="h-2 w-2 rounded-full <%= reservation_status_dot_class(reservation.status) %>"></span>
                          <%= reservation_status_label(reservation.status) %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <%= paginate @reservations %>
            </div>
          <% else %>
            <p class="px-6 py-10 text-center text-sm text-gray-500">No active reservations right now.</p>
          <% end %>
        </div>
      </main>
    </div>
  </div>
</div>
</div>
