<div class="min-h-screen bg-[#FBF0EC] py-10 pt-28">
  <div class="w-full">
    <div class="flex gap-6">
      <%= render "layouts/admin_sidebar" %>

      <main class="flex-1 space-y-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Management Suite</p>
            <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-gray-900">Restaurant Performance</h1>
          </div>

          <%= form_with url: performance_admin_dashboards_path, method: :get, class: "flex flex-col gap-3 sm:flex-row sm:items-center" do %>
            <input type="date" name="from_date" value="<%= @from_date %>" class="rounded-full border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:border-[#8A1C2B] focus:outline-none">
            <input type="date" name="to_date" value="<%= @to_date %>" class="rounded-full border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 focus:border-[#8A1C2B] focus:outline-none">
            <button type="submit" class="inline-flex items-center justify-center rounded-full bg-[#8A1C2B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]">
              Apply
            </button>
          <% end %>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-6">
          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Net Revenue</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= money(@performance[:summary][:net_revenue]) %></p>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Gross Profit</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= money(@performance[:summary][:gross_profit]) %></p>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Gross Margin</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= percent(@performance[:summary][:gross_margin]) %>%</p>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Waste Cost</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= money(@performance[:summary][:waste_cost]) %></p>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">AOV</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= money(@performance[:operations][:aov]) %></p>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500">Avg Rating</p>
            <p class="mt-4 font-serif text-3xl font-semibold text-gray-900"><%= rating(@performance[:customer][:avg_rating]) %>/5</p>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between gap-4">
              <h2 class="font-serif text-2xl font-semibold text-gray-900">Revenue by day</h2>
              <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#8A1C2B]">Trend</span>
            </div>
            <%= trend_chart(@performance[:daily_trend]) %>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between gap-4">
              <h2 class="font-serif text-2xl font-semibold text-gray-900">Revenue by month</h2>
              <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#8A1C2B]">Trend</span>
            </div>
            <%= trend_chart(@performance[:monthly_trend]) %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Revenue</h2>
            <div class="mt-5 space-y-4 text-sm text-gray-700">
              <div class="flex items-center justify-between">
                <span>Gross sales</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:revenue][:gross]) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Refunds</span>
                <span class="font-semibold text-red-600"><%= money(@performance[:revenue][:refund]) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Net revenue</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:revenue][:net]) %></span>
              </div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Costs</h2>
            <div class="mt-5 space-y-4 text-sm text-gray-700">
              <div class="flex items-center justify-between">
                <span>COGS</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:costs][:cogs]) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Waste cost</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:costs][:waste]) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Profit after waste</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:profit][:after_waste]) %></span>
              </div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Operations</h2>
            <div class="mt-5 space-y-4 text-sm text-gray-700">
              <div class="flex items-center justify-between">
                <span>Occupancy</span>
                <span class="font-semibold text-gray-900"><%= percent(@performance[:operations][:occupancy_rate]) %>%</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Order mix</span>
                <span class="font-semibold text-gray-900"><%= @performance[:operations][:order_status].to_h.inspect %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Reviews</span>
                <span class="font-semibold text-gray-900"><%= @performance[:customer][:reviews_count] %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Reservation Funnel</h2>
            <div class="mt-5 space-y-4 text-sm text-gray-700">
              <% @performance[:reservation_funnel].each do |status, value| %>
                <div class="flex items-center justify-between">
                  <span class="capitalize"><%= status.to_s.humanize %></span>
                  <span class="font-semibold text-gray-900"><%= value %></span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Inventory Health</h2>
            <div class="mt-5 space-y-4 text-sm text-gray-700">
              <div class="flex items-center justify-between">
                <span>Total stock value</span>
                <span class="font-semibold text-gray-900"><%= money(@performance[:inventory][:total_stock_value]) %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Low stock</span>
                <span class="font-semibold text-gray-900"><%= @performance[:inventory][:low_stock_count] %></span>
              </div>
              <div class="flex items-center justify-between">
                <span>Out of stock</span>
                <span class="font-semibold text-gray-900"><%= @performance[:inventory][:out_of_stock_count] %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="font-serif text-2xl font-semibold text-gray-900">Recent Reservations</h2>
            <%= link_to "Back to overview", admin_dashboards_path, class: "inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
          </div>

          <% if @reservations.present? %>
            <div class="mt-6 overflow-x-auto">
              <table class="min-w-full text-left text-sm text-gray-700">
                <thead class="bg-[#FEF3E8] text-xs uppercase tracking-[0.16em] text-gray-500">
                  <tr>
                    <th scope="col" class="px-6 py-4">Guest</th>
                    <th scope="col" class="px-6 py-4">Party</th>
                    <th scope="col" class="px-6 py-4">Time</th>
                    <th scope="col" class="px-6 py-4">Table</th>
                    <th scope="col" class="px-6 py-4">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  <% @reservations.each do |reservation| %>
                    <tr class="transition hover:bg-[#FAF5F1]">
                      <td class="px-6 py-5">
                        <div class="flex items-center gap-4">
                          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#8A1C2B]/10 text-sm font-semibold text-[#8A1C2B]">
                            <%= reservation.guest_name.to_s[0, 2].upcase %>
                          </div>
                          <div>
                            <p class="text-sm font-semibold text-gray-900"><%= reservation.guest_name %></p>
                            <% if reservation.user.present? %>
                              <p class="mt-1 text-xs text-gray-500"><%= reservation.user.full_name %></p>
                            <% end %>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.table&.capacity %> guests</td>
                      <td class="px-6 py-5 text-sm text-gray-600"><%= reservation.reservation_time&.strftime("%I:%M %p") %></td>
                      <td class="px-6 py-5 text-sm text-gray-600">Table <%= reservation.table&.table_number %></td>
                      <td class="px-6 py-5">
                        <span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-gray-700">
                          <span class="h-2 w-2 rounded-full bg-[#8A1C2B]"></span>
                          <%= reservation.status.to_s.humanize %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <%= paginate @reservations %>
            </div>
          <% else %>
            <p class="px-6 py-10 text-center text-sm text-gray-500">No active reservations right now.</p>
          <% end %>
        </div>
      </main>
    </div>
  </div>
</div>
