<%= form_with model: @area, class: "mx-auto w-full max-w-3xl space-y-6" do |form| %>
  <% if @area.errors.any? %>
    <div id="error_explanation" class="rounded-2xl bg-red-50 px-4 py-3 font-medium text-red-600">
      <h2 class="font-semibold"><%= pluralize(@area.errors.count, "error") %> prohibited this area from being saved:</h2>
      <ul class="ml-5 mt-1 list-disc">
        <% @area.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Area details card -->
  <div class="rounded-[1.75rem] border border-[#8A1C2B]/10 bg-white/80 p-6 shadow-sm sm:p-8">
    <div class="mb-8">
      <h2 class="font-serif text-2xl font-semibold text-gray-900">Area details</h2>
      <p class="mt-1 text-sm text-gray-500">Define a space in your restaurant so you can place tables on it.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <!-- Name -->
      <div class="sm:col-span-2">
        <%= form.label :name, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🏷️</span>
          Name
        <% end %>
        <%= form.text_field :name,
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              placeholder: "e.g. Main Dining Floor",
              required: true %>
      </div>

      <!-- Area type -->
      <div>
        <%= form.label :area_type, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🏠</span>
          Area type
        <% end %>
        <%= form.select :area_type,
              Area.area_types.keys.map { |key| [key.humanize, key] },
              { selected: @area.area_type || "indoor" },
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              required: true %>
      </div>

      <!-- Floor level -->
      <div>
        <%= form.label :floor_level, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🏢</span>
          Floor level
        <% end %>
        <%= form.number_field :floor_level,
              class: "mt-1 block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              placeholder: "e.g. 1",
              min: 1,
              required: true %>
      </div>

      <!-- Floor map image -->
      <div class="sm:col-span-2">
        <%= form.label :image, class: "mb-1.5 flex items-center gap-2 text-sm font-semibold text-gray-700" do %>
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#8A1C2B]/10 text-sm">🖼️</span>
          Floor map image
        <% end %>

        <% if @area.persisted? && @area.image.attached? %>
          <%= image_tag @area.image,
                class: "mb-3 h-40 w-full rounded-2xl border border-gray-200 object-cover shadow-sm",
                alt: "Current floor map for #{@area.name}" %>
        <% end %>

        <%= form.file_field :image,
              class: "mt-1 block w-full cursor-pointer rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-700 shadow-sm outline-none transition file:mr-3 file:rounded-lg file:border-0 file:bg-[#8A1C2B]/10 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-[#8A1C2B] hover:file:bg-[#8A1C2B]/20 focus:border-[#8A1C2B] focus:ring-2 focus:ring-[#8A1C2B]/20",
              accept: "image/png,image/jpeg,image/jpg,image/webp" %>
        <p class="mt-1.5 text-xs text-gray-500">Optional. PNG, JPEG, or WEBP floor map you'll place tables on. Leave blank to keep the current image.</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-8 flex justify-end">
      <%= form.submit @area.persisted? ? "Update area" : "Create area",
            class: "inline-flex items-center gap-2 rounded-full bg-[#8A1C2B] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#6d1420]" %>
    </div>
  </div>
<% end %>

