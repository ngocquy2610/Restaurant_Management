<% content_for :title, "Foods" %>

<div class="min-h-screen pt-[5.25rem] bg-[#f4e6e2] text-[#2f1f1d]">
  <div class="flex min-h-screen">
    

    <main class="flex-1 bg-[#f6efee] px-8 py-6">
      <div class="mx-auto max-w-[1260px]">

        <% if notice.present? %>
          <p class="mb-5 inline-block rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-600" id="notice"><%= notice %></p>
        <% end %>

        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-serif text-[4rem] leading-none tracking-[-0.06em] text-[#2f1f1d]">Menu Foods</h2>
            <p class="mt-3 text-[1.15rem] text-[#7a5a56]">Manage the dishes of your dining experience.</p>
          </div>

        </div>

        <div id="foods" class="space-y-8">
          <% if @foods.any? %>
            <% Category.order(:name).each do |category| %>
              <% category_foods = @foods.select { |food| food.category_id == category.id } %>

              <section class="rounded-[20px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
                <div class="mb-5 flex items-center justify-between border-b border-[#e4d2ce] pb-4">
                  <h3 class="font-serif text-[2rem] font-semibold tracking-tight text-[#2f1f1d]"><%= category.name %></h3>
                  <span class="inline-flex items-center rounded-full bg-[#6a4c4b] px-3 py-1 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white"><%= pluralize(category_foods.size, "item") %></span>
                </div>

                <% if category_foods.any? %>
                  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
                    <% category_foods.each do |food| %>
                      <%
                        image_url = if food.image.attached?
                          url_for(food.image)
                        else
                          "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=80"
                        end
                        category_name = food.category&.name || "Menu"
                      %>
                      <%= link_to menu_path(food), class: "group block overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
                        <div class="relative h-44 w-full overflow-hidden bg-cover bg-center" style="background-image: url('<%= image_url %>');">
                          <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-black/10 to-transparent"></div>
                          <span class="absolute bottom-3 left-4 rounded-md bg-[#f6efe8] px-3 py-2 text-[1.05rem] font-semibold text-[#3a2a28] shadow-sm">
                            $<%= number_to_currency(food.base_price, precision: 2, unit: "") %>
                          </span>
                        </div>

                        <div class="p-5 text-center">
                          <h3 class="font-serif text-[1.5rem] font-semibold leading-tight tracking-tight text-[#2f1f1d]"><%= food.name %></h3>

                          <div class="mt-2 flex items-center justify-center gap-2">
                            <span class="inline-flex items-center rounded-full bg-[#f0e7e5] px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-[#5d4b49]"><%= category_name %></span>
                            <span class="text-[0.85rem] text-[#8a6f6a]"><%= pluralize(food.food_variants.count, "variant") %></span>
                          </div>

                          <p class="mt-3 min-h-[3.2rem] text-[0.95rem] leading-relaxed text-[#7a5a56]"><%= food.description.to_s.truncate(50) %></p>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <p class="rounded-[16px] border-2 border-dashed border-[#d7b9b2] bg-[#f8f3f1] py-10 text-center text-[1.05rem] text-[#8a6f6a]">
                    No foods in this category yet.
                  </p>
                <% end %>
              </section>
            <% end %>
          <% else %>
            <div class="flex min-h-[360px] items-center justify-center rounded-[20px] border-2 border-dashed border-[#d7b9b2] bg-[#f8f3f1]">
              <div class="max-w-md text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[#f1e3df] text-3xl">🍽️</div>
                <h3 class="font-serif text-[2.2rem] font-semibold tracking-tight text-[#2f1f1d]">No foods yet</h3>
                <p class="mt-3 text-[1.05rem] text-[#7a5a56]">Start by adding your first dish to this menu.</p>
                <%= link_to "Add First Food", new_food_path, class: "mt-6 inline-flex items-center justify-center rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>
