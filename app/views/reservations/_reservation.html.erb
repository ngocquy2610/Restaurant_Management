<%= content_tag :div, id: dom_id(reservation), class: "rounded-2xl border border-gray-200 bg-white p-6 shadow-sm" do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="font-serif text-xl font-semibold text-gray-900"><%= reservation.guest_name %></p>
      <p class="mt-1 text-sm text-gray-500"><%= reservation.guest_phone %></p>
    </div>
    <span class="shrink-0 inline-flex items-center gap-2 rounded-full <%= reservation_status_chip_class(reservation.status) %> px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= reservation_status_meta(reservation.status)[:text] %>">
      <span class="h-2 w-2 rounded-full <%= reservation_status_dot_class(reservation.status) %>"></span>
      <%= reservation_status_label(reservation.status) %>
    </span>
  </div>

  <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Table</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-800">Table <%= reservation.table&.table_number %></dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Date & time</dt>
      <dd class="mt-1 text-sm font-semibold text-gray-800">
        <%= reservation.reservation_date %> · <%= reservation.reservation_time&.strftime("%I:%M %p") %>
      </dd>
    </div>
    <% if reservation.note.present? %>
      <div class="sm:col-span-2">
        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Note</dt>
        <dd class="mt-1 text-sm text-gray-600"><%= reservation.note %></dd>
      </div>
    <% end %>
  </dl>
  <% meal_review = reservation.meal_review %>
  <% if meal_review.present? %>
    <p class="mt-4 flex items-center gap-2 border-t border-gray-100 pt-3 text-xs font-semibold text-gray-500">
      <span class="text-amber-400"><%= review_stars(meal_review.rating) %></span>
      You reviewed this meal
    </p>
  <% elsif current_user && policy(reservation).review_meal? %>
    <div class="mt-4 border-t border-gray-100 pt-3">
      <%= link_to "Review this meal",
            new_review_path(reservation_id: reservation.id, review_type: "meal"),
            class: "rounded-full border border-gray-200 px-4 py-1.5 text-xs font-semibold text-gray-700 transition hover:border-[#8A1C2B] hover:text-[#8A1C2B]" %>
    </div>
  <% end %>

<% end %>
