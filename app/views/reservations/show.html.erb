<% content_for :title, "Reservation ##{@reservation.id}" %>

<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-4xl space-y-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Reservation</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Booking details</h1>
      </div>
      <%= link_to "Back to reservations", reservations_path, class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>

    <%= render @reservation %>

    <%# Staff-only status actions (reject / approve / check-in etc.) %>
    <% if current_user&.admin? || current_user&.receptionist? %>
      <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm">
        <h2 class="font-serif text-xl font-semibold text-gray-900">Update status</h2>
        <p class="mt-1 text-sm text-gray-500">Rejecting frees the table back to available; approving keeps it reserved.</p>

        <%= form_with(model: @reservation, url: update_status_reservation_path(@reservation), method: :patch, class: "mt-5 space-y-4") do |form| %>
          <% if @reservation.errors.any? %>
            <div id="status_error_explanation" class="rounded-md border border-[#e5b3ad] bg-[#fbe9e6] px-4 py-3 text-sm text-[#8f1f2a]">
              <% @reservation.errors.full_messages.each do |message| %>
                <p><%= message %></p>
              <% end %>
            </div>
          <% end %>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <div class="w-full sm:max-w-xs">
              <%= form.label :status, "Status", class: "mb-2 block text-sm font-semibold uppercase tracking-wide text-[#7c5d58]" %>
              <%= form.select :status,
                    Reservation.statuses.keys.map { |s| [s.humanize, s] },
                    class: "w-full rounded-md border border-[#d8c1bc] bg-[#f8efee] px-4 py-3 text-[1rem] text-[#2c1c1a] focus:outline-none focus:ring-2 focus:ring-[#c0928d]" %>
            </div>
            <%= form.submit "Update status",
                  class: "cursor-pointer rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
          </div>
        <% end %>

        <div class="mt-4 flex flex-wrap gap-3 border-t border-gray-100 pt-4">
          <%= button_to "Approve", update_status_reservation_path(@reservation),
                method: :patch,
                params: { reservation: { status: :approved } },
                class: "cursor-pointer rounded-full bg-green-600 px-5 py-2 text-sm font-semibold text-white hover:bg-green-700",
                data: { turbo_confirm: "Approve this reservation?" } %>
          <%= button_to "Reject", update_status_reservation_path(@reservation),
                method: :patch,
                params: { reservation: { status: :rejected } },
                class: "cursor-pointer rounded-full border border-red-200 bg-red-50 px-5 py-2 text-sm font-semibold text-red-700 hover:bg-red-100",
                data: { turbo_confirm: "Reject this reservation? The table will be freed." } %>
        </div>
      </div>
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to "Edit this reservation", edit_reservation_path(@reservation), class: "inline-flex items-center rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50" %>
      <%= button_to "Destroy this reservation", @reservation, method: :delete, form_class: "inline-block", class: "cursor-pointer rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</div>
