<% content_for :title, @recipe_item.ingredient&.name || "Recipe Item" %>

<div class="min-h-screen bg-[#f4e6e2] pt-[5.25rem] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[720px] flex-col px-6 py-12">
    <%= link_to recipe_items_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to recipe items
    <% end %>

    <% if notice.present? %>
      <p class="mb-6 inline-block rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-600" id="notice"><%= notice %></p>
    <% end %>

    <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-8 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-[#7c5d58]"><%= @recipe_item.food&.name || "Unknown food" %></p>
          <h1 class="mt-1 font-serif text-4xl font-semibold tracking-tight text-[#2f1f1d]"><%= @recipe_item.ingredient&.name || "Unknown ingredient" %></h1>
          <p class="mt-2 text-[#7a5a56]"><%= @recipe_item.food_variant&.name || "Base recipe" %></p>
        </div>
        <span class="whitespace-nowrap rounded-md bg-[#7b1f2a] px-3 py-2 text-[1.2rem] font-semibold text-white shadow-sm">
          <%= @recipe_item.quantity_required %>
          <% if @recipe_item.ingredient&.unit.present? %>
            <%= @recipe_item.ingredient.unit %>
          <% end %>
        </span>
      </div>

      <div class="mt-6 flex items-center gap-2 border-t border-[#e4d6d2] pt-6">
        <%= link_to "Edit", edit_recipe_item_path(@recipe_item), class: "flex h-10 flex-1 items-center justify-center rounded-md border border-[#d8c1bc] bg-[#f8efee] text-sm font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
        <%= button_to "Delete", @recipe_item, method: :delete, data: { turbo_confirm: "Delete this recipe item? This cannot be undone." }, class: "flex h-10 flex-1 cursor-pointer items-center justify-center rounded-md bg-[#8f1f2a] text-sm font-semibold text-white hover:bg-[#7a1a23]" %>
      </div>
    </div>
  </main>
</div>
