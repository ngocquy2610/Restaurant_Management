<article id="<%= dom_id recipe_item %>" class="flex flex-col overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-6 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-serif text-[1.6rem] font-semibold leading-tight tracking-tight text-[#2f1f1d]">
        <%= recipe_item.ingredient&.name || "Unknown ingredient" %>
      </h3>
      <p class="mt-1 text-[0.95rem] text-[#7a5a56]">
        <%= recipe_item.food&.name || "Unknown food" %>
        <% if recipe_item.food_variant.present? %>
          <span class="text-[#5c4543]">· <%= recipe_item.food_variant.name %></span>
        <% else %>
          <span class="text-[#5c4543]">· Base recipe</span>
        <% end %>
      </p>
    </div>
    <span class="whitespace-nowrap rounded-md bg-[#7b1f2a] px-3 py-2 text-[1.1rem] font-semibold text-white shadow-sm">
      <%= recipe_item.quantity_required %>
      <% if recipe_item.ingredient&.unit.present? %>
        <%= recipe_item.ingredient.unit %>
      <% end %>
    </span>
  </div>

  <div class="mt-6 flex items-center gap-2 border-t border-[#e4d6d2] pt-5">
    <%= link_to "Show", recipe_item, class: "flex h-10 flex-1 items-center justify-center rounded-md border border-[#d8c1bc] bg-[#f8efee] text-sm font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
    <%= link_to "Edit", edit_recipe_item_path(recipe_item), class: "flex h-10 flex-1 items-center justify-center rounded-md border border-[#d8c1bc] bg-[#f8efee] text-sm font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
    <%= button_to "Delete", recipe_item, method: :delete, data: { turbo_confirm: "Delete this recipe item? This cannot be undone." }, class: "flex h-10 flex-1 cursor-pointer items-center justify-center rounded-md bg-[#8f1f2a] text-sm font-semibold text-white hover:bg-[#7a1a23]" %>
  </div>
</article>
