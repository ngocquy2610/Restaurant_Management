<% content_for :title, @review.restaurant? ? "Review the restaurant" : "Review your meal" %>

<div class="min-h-screen bg-[#FBF0EC] px-4 py-10 pt-28">
  <div class="mx-auto max-w-3xl space-y-6">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.32em] text-[#8A1C2B]/80">Your review</p>
      <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
        <%= @review.restaurant? ? "How was Lumière Dining?" : "How was your meal?" %>
      </h1>
      <p class="mt-3 text-sm text-gray-600">
        <% if @review.restaurant? %>
          Your one-time impression of the restaurant — it will be shown on the menu page.
        <% else %>
          Your review is tied to this visit, so other guests know exactly which meal you are describing.
        <% end %>
      </p>
    </div>

    <% if notice.present? %>
      <p class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-700" id="notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" id="alert"><%= alert %></p>
    <% end %>

    <div class="rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
      <%= render "form", review: @review %>
    </div>
  </div>
</div>
