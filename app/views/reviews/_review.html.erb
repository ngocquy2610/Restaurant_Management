<div id="<%= dom_id(review) %>" class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-serif text-lg font-semibold text-gray-900"><%= review.reviewer_name %></p>
        <%= review_type_badge(review.review_type) %>
      </div>
      <p class="mt-1 text-sm text-gray-500">
        <%= review.restaurant? ? "The whole restaurant" : "Table #{review.table&.table_number || '—'}" %>
        · <%= review.meal_label %>
      </p>
    </div>
    <div class="shrink-0 text-right">
      <div class="text-lg text-amber-400"><%= review_stars(review.rating) %></div>
      <p class="mt-0.5 text-xs font-semibold text-gray-500"><%= review.rating %>/5</p>
    </div>
  </div>

  <% if review.comment.present? %>
    <div class="mt-3 text-sm leading-relaxed text-gray-600"><%= simple_format(review.comment) %></div>
  <% end %>

  <% if policy(review).update? %>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-gray-100 pt-3">
      <%= link_to "Edit", edit_review_path(review),
            class: "rounded-full border border-gray-200 px-4 py-1.5 text-xs font-semibold text-gray-700 transition hover:border-[#8A1C2B] hover:text-[#8A1C2B]" %>
      <%= button_to "Delete", review_path(review), method: :delete, form_class: "inline-block",
            class: "cursor-pointer rounded-full bg-red-600 px-4 py-1.5 text-xs font-semibold text-white transition hover:bg-red-500",
            data: { turbo_confirm: "Delete this review?" } %>
    </div>
  <% end %>
</div>
