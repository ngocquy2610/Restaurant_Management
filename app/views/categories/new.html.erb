<% content_for :title, "New category" %>

<div class="min-h-screen pt-[5.25rem] bg-[#f4e6e2] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[880px] flex-col px-6 py-12">
    <%= link_to categories_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to categories
    <% end %>

    <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-8 shadow-sm">
    <div class="mb-1 flex items-center gap-2 text-sm font-semibold">
      <span class="rounded-full bg-[#7b1f2a] px-2.5 py-1 text-[0.72rem] uppercase tracking-[0.1em] text-white">New</span>
      <span class="uppercase tracking-[0.14em] text-[#9b6a63] text-xs">Menu structure</span>
    </div>
    <h1 class="font-serif text-4xl font-semibold tracking-tight">New category</h1>
    <p class="mt-2 text-[1.05rem] text-[#7a5a56]">Add a category to organize your menu. It will hold <strong>dishes</strong> (e.g. Starters → Spring Rolls).</p>

      <div class="mt-8">
        <%= render "form", category: @category, existing_names: @existing_categories.map(&:name) %>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">Naming rules</p>
        <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-[#5e4b48]">
          <li>✓ 2–60 characters, any wording you like</li>
          <li>✓ Unique — duplicates rejected even with different casing</li>
          <li>✓ Examples: Starters, Main Course, Desserts, Beverages</li>
        </ul>
      </div>
      <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-5 shadow-sm">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[#9b6a63]">
          Existing (<%= @total_categories %>)<% if @existing_categories.any? %> — latest 10<% end %>
        </p>
        <% if @existing_categories.any? %>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% @existing_categories.each do |c| %>
              <span class="rounded-full border border-[#d8c1bc] bg-white px-2.5 py-1 text-xs font-medium text-[#5c4543]"><%= c.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-2 text-sm text-[#8a6f6a]">No categories yet — yours will be the first.</p>
        <% end %>
      </div>
    </div>
  </main>
</div>

