<% content_for :title, @category.name %>

<div class="min-h-screen pt-[5.25rem] bg-[#f4e6e2] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[640px] flex-col px-6 py-12">
    <%= link_to categories_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to categories
    <% end %>

    <div class="rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] p-8 shadow-sm">
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-[#2f1f1d]"><%= @category.name %></h1>
      <p class="mt-2 text-[1.05rem] text-[#7a5a56]"><%= pluralize(@category.foods.count, "item") %> in this category.</p>

      <div class="mt-6 flex items-center gap-3">
        <%= link_to "Edit", edit_category_path(@category), class: "rounded-md bg-[#7b1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#661a23]" %>
        <%= button_to "Delete", @category, method: :delete, data: { turbo_confirm: "Delete this category? Its foods will also be removed." }, class: "cursor-pointer rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 text-base font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
      </div>
    </div>

  </main>
</div>
