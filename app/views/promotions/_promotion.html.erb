<div id="<%= dom_id promotion %>" class="flex flex-1 flex-col">
  <div class="relative h-44 w-full overflow-hidden bg-[#f1e3df]">
    <% if promotion.image.attached? %>
      <%= image_tag promotion.image, class: "h-full w-full object-cover" %>
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent"></div>
    <% else %>
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-[#e9d4d0] to-[#d8b6af] text-5xl">🏷️</div>
    <% end %>

    <span class="absolute bottom-3 left-4 rounded-md bg-[#f6efe8] px-3 py-2 text-[1.05rem] font-semibold text-[#3a2a28] shadow-sm">
      <% if promotion.discount_type == "percentage" %>
        <%= promotion.discount_value %>%
      <% else %>
        $<%= number_to_currency(promotion.discount_value, precision: 2, unit: "") %>
      <% end %>
    </span>

    <% if promotion.status.present? %>
      <span class="absolute right-3 top-3 rounded-full px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] <%= promotion.status == 'published' ? 'bg-green-600 text-white' : 'bg-[#8f1f2a] text-white' %>">
        <%= promotion.status.titleize %>
      </span>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-serif text-[1.5rem] font-semibold leading-tight tracking-tight text-[#2f1f1d]"><%= promotion.name %></h3>

    <p class="mt-3 text-[0.95rem] leading-relaxed text-[#7a5a56]">
      <%= promotion.discount_type == "percentage" ? "#{promotion.discount_value}% off" : "$#{number_to_currency(promotion.discount_value, precision: 2, unit: '')} off" %>
      every order
    </p>

    <div class="mt-auto flex items-center justify-between gap-2 border-t border-[#e4d2ce] pt-4 text-sm text-[#8a6f6a]">
      <% if promotion.start_date && promotion.end_date %>
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <%= l(promotion.start_date, format: :short) %>
        </span>
        <span class="text-[#c3a7a1]">→</span>
        <span><%= l(promotion.end_date, format: :short) %></span>
      <% end %>
    </div>
  </div>
</div>
