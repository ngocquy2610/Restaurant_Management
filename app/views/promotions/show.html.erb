<% content_for :title, "Showing promotion" %>

<div class="pt-[5.25rem] min-h-screen bg-[#f4e6e2] text-[#2f1f1d]">
  <main class="mx-auto flex w-full max-w-[860px] flex-col px-6 py-12">
    <% if notice.present? %>
      <p class="mb-6 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-green-700" id="notice"><%= notice %></p>
    <% end %>

    <%= link_to promotions_path, class: "mb-8 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-[#7b1f2a] hover:text-[#661a23]" do %>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Back to promotions
    <% end %>

    <div class="overflow-hidden rounded-[16px] border border-[#d7b9b2] bg-[#f8f3f1] shadow-sm">
      <%= render @promotion %>

      <div class="flex flex-wrap items-center gap-3 border-t border-[#e4d2ce] px-5 py-4">
        <%= link_to "Edit this promotion", edit_promotion_path(@promotion), class: "rounded-md border border-[#d8c1bc] bg-[#f8efee] px-5 py-3 text-base font-semibold text-[#5c4543] hover:bg-[#f1dfdf]" %>
        <%= button_to "Destroy this promotion", @promotion, method: :delete, form_class: "inline", data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer rounded-md bg-[#8f1f2a] px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#7a1a23]" %>
      </div>
    </div>
  </main>
</div>
